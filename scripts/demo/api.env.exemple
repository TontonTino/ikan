# Configuration de l'API de DÉMONSTRATION → copier en /home/ec2-user/ikan-demo/api.env (chmod 600). Jamais dans git.
APP_ENV=production
DEBUG=false
DEMO_MODE=oui
# Comptes ouverts par les boutons « Entrer comme… » (e-mails existant dans la base de démo).
DEMO_COMPTE_CX=cx@demo.ikanai.bf
DEMO_COMPTE_AGENCE=agence@demo.ikanai.bf
# Base de démo : JAMAIS la production (l'API refuse alors de démarrer).
DATABASE_URL=postgresql://ikan_demo:MOT_DE_PASSE@127.0.0.1:5432/ikan_demo
# Clé propre à la démo (python -c "import secrets; print(secrets.token_urlsafe(48))"), différente de la production.
SECRET_KEY=A_GENERER
ALLOWED_ORIGINS=https://demo.ikanai.bf
PUBLIC_DASHBOARD_URL=https://demo.ikanai.bf
PUBLIC_CLIENT_URL=https://demo.ikanai.bf
TRUSTED_PROXY_HOPS=1
# YAM de la démo (même valeur de WEBHOOK_SECRET dans agent.env).
AGENT_WEBHOOK_URL=http://127.0.0.1:8101
WEBHOOK_SECRET=A_GENERER
# Volontairement VIDES dans la démo : aucun paiement, aucun e-mail réel, aucune veille réelle.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
VEILLE_SERVICE_URL=
VEILLE_API_KEY=
