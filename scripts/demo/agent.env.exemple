# Configuration de YAM pour la DÉMONSTRATION → copier en /home/ec2-user/ikan-demo/agent.env (chmod 600). Jamais dans git.
APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql://ikan_demo:MOT_DE_PASSE@127.0.0.1:5432/ikan_demo
# MÊMES valeurs que dans api.env de la démo.
SECRET_KEY=A_GENERER
WEBHOOK_SECRET=A_GENERER
ALLOWED_ORIGINS=https://demo.ikanai.bf
# De préférence une clé Groq séparée de la production : les visiteurs consomment son quota.
GROQ_API_KEY=
# Volontairement VIDES : YAM n'envoie aucun vrai message WhatsApp depuis la démo.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
