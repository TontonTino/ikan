# Base de données
DATABASE_URL=postgresql://postgres:password@localhost:5432/ikanai

# JWT
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# CORS (origines autorisées)
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173

# Email (alertes de quota, Phase 3). Fournisseur recommandé : Brevo (tier gratuit
# 300 emails/jour, "From" sur votre propre domaine) — smtp-relay.brevo.com:587,
# MAIL_USERNAME = login SMTP Brevo (page SMTP du compte), MAIL_PASSWORD = clé SMTP
# (xsmtpsib-...). Vide = alertes silencieusement désactivées (fail-safe, log seulement).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ikanai.app
MAIL_PORT=587
MAIL_SERVER=smtp-relay.brevo.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Agent IA YAM (optionnel). URL de base du service agent + secret PARTAGÉ avec apps/agent/.env.
# Laisser vide pour désactiver la notification.
AGENT_WEBHOOK_URL=
WEBHOOK_SECRET=

# Stripe (facturation en libre-service). Utiliser des clés sk_test_.../pk_test_...
# en développement — aucune transaction réelle n'est possible avec une clé de test.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret de signature du webhook (Stripe Dashboard > Webhooks, ou `stripe listen`).
STRIPE_WEBHOOK_SECRET=

# URL de base du dashboard (redirections Stripe Checkout success/cancel).
PUBLIC_DASHBOARD_URL=http://localhost:5173

# Protection du formulaire public (compteurs en mémoire : valables pour UNE instance ; 0 = désactivé).
# Une agence partage souvent un seul Wi-Fi : ne pas descendre ces seuils sans mesurer.
RATE_LIMIT_FEEDBACK_PAR_IP=10
RATE_LIMIT_FEEDBACK_PAR_QR=30
RATE_LIMIT_PUBLIC_PAR_IP=60
PUBLIC_BODY_MAX_OCTETS=16384
# Proxys de confiance DEVANT l'API (0 = aucun, X-Forwarded-For ignoré ; sur Render : 1). Une valeur fausse fait
# partager un même compteur à tous les visiteurs (ou rend l'adresse falsifiable) : à vérifier au déploiement.
TRUSTED_PROXY_HOPS=0
# Secret partagé avec apps/client (même valeur des deux côtés) : permet au serveur du client de transmettre l'adresse du visiteur.
SSR_FORWARD_SECRET=
