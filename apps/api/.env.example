# Base de données
DATABASE_URL=postgresql://postgres:password@localhost:5432/ikanai

# JWT
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# CORS (origines autorisées)
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173

# Email (pour les alertes)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ikanai.app
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
