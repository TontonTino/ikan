# Adresse de base de l'API (sans slash final).
# En DÉVELOPPEMENT : facultative, repli sur http://localhost:8000/api/v1.
# En PRODUCTION : OBLIGATOIRE. Sans elle, `npm run build` s'arrête et `npm start` refuse de démarrer en la nommant
#   (voir serveur/adresse-api.mjs). Renseignez-la dans l'environnement du service.
PUBLIC_API_URL=http://localhost:8000/api/v1

# Serveur du client (SSR) : transmission de l'adresse du visiteur à l'API pour sa limitation de débit.
# SSR_FORWARD_SECRET = MÊME valeur que dans apps/api/.env ; TRUSTED_PROXY_HOPS = proxys de confiance devant ce serveur (Render : 1).
SSR_FORWARD_SECRET=
TRUSTED_PROXY_HOPS=0
