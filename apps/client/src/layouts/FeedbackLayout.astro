---
export interface Props {
  title?: string;
  agenceNom?: string;
}
const { title = 'IKAN AI — Votre avis', agenceNom } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#02302D" />
    <meta name="description" content="Donnez votre avis sur votre expérience en agence — IKAN AI" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/ikanai-mark.png" />
    <link rel="apple-touch-icon" href="/ikanai-mark.png" />
    <!-- Poppins hébergée localement (sous-ensemble latin, public/fonts/) : aucun appel à Google Fonts. -->
    <link rel="preload" href="/fonts/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/poppins-latin-400-normal.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('/fonts/poppins-latin-500-normal.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/poppins-latin-600-normal.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/poppins-latin-700-normal.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Poppins';
        font-style: normal;
        font-weight: 800;
        font-display: swap;
        src: url('/fonts/poppins-latin-800-normal.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      /* Jetons du formulaire client : MÊMES valeurs que apps/dashboard/src/styles/tokens.css (palette du lot 2a).
         Un rôle fixe par couleur ; le lot 2c y ramène les couleurs écrites en dur dans pages/feedback/[code].astro. */
      :root {
        --color-encre: #02302D;        /* titres, texte principal */
        --color-text-2: #5C7268;       /* texte secondaire */
        --color-accent: #C54825;       /* boutons et liens (variante conforme de #C94A26 : 4,53:1 sur la crème) */
        --color-accent-hover: #A63C1E;
        --color-accent-vif: #E5603B;   /* icônes et traits, jamais de texte */
        --color-marque: #3C7830;       /* logo et statut « bon » */
        --color-citron: #BCCF00;       /* décor, jamais de texte */
        --color-bg: #F6F8F1;           /* fond de page */
        --color-surface: #FFFFFF;      /* cartes */
        --color-border: #7E8F84;       /* champs et boutons */
        --color-trait: #D3DACA;        /* séparateurs, contours */
        --color-text-inverse: #FFFFFF;
        --color-bon-texte: #1F5A25;         --color-bon-fond: #E8F0E0;
        --color-surveiller-texte: #7A5200;  --color-surveiller-fond: #FBF0D0;
        --color-critique-texte: #8C3A1B;    --color-critique-fond: #FBE8E2;
        --color-neutre-texte: #3D4A44;      --color-neutre-fond: #EEF1EC;

        --text-xs: 0.75rem; --text-sm: 0.875rem; --text-base: 0.9375rem; --text-lg: 1.125rem; --text-xl: 1.375rem; --text-2xl: 1.75rem;
        --weight-normal: 400; --weight-semibold: 600;
        --font-main: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

        /* Alias historiques (ne pas supprimer : utilisés par le formulaire) */
        --color-dark: var(--color-encre);
        --color-forest: var(--color-encre);
        --color-primary: var(--color-marque);
        --color-lime: var(--color-citron);
        --font-poppins: var(--font-main);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: var(--font-poppins) !important;
      }

      /* Empêche le zoom auto iOS Safari quand l'utilisateur touche un champ de saisie */
      input, textarea, select {
        font-size: 16px !important;
        touch-action: manipulation;
      }

      html, body {
        min-height: 100vh;
        min-height: 100dvh;
        width: 100%;
        background-color: var(--color-bg);
        color: var(--color-dark);
        overflow-x: hidden;
        overflow-y: auto;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      .mobile-container {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
        padding: 24px 16px;
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>