    70% { box-shadow: 0 0 0 7px rgba(188, 207, 0, 0); }
    100% { box-shadow: 0 0 0 0 rgba(188, 207, 0, 0); }
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-title {
    font-size: clamp(1.15rem, 2.8vw, 1.45rem);
