  /* Champ piège : hors écran (et non display:none, que certains robots détectent), hors parcours clavier. */
  .champ-piege {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Case de consentement : la vraie case (44 x 44 px, invisible) couvre la zone tactile ; la case dessinée (24 px) est
     centrée dessus. Toute la ligne reste cliquable (<label for>). */
  .consent-row {
    position: relative;
    display: block;
    min-height: 44px;
