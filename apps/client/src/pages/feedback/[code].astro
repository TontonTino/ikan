  // ================= DICTÉE VOCALE (WEB SPEECH API) =================
  const micBtn = document.getElementById('micBtnCommentaire') as HTMLButtonElement | null;
  const voiceStatus = document.getElementById('voiceStatusCommentaire');

  if (micBtn && commentInput && voiceStatus) {
    const SpeechRecognitionCtor =
      (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;

    if (!SpeechRecognitionCtor) {
      micBtn.disabled = true;
      micBtn.title = "La reconnaissance vocale n'est pas supportée par ce navigateur.";
      voiceStatus.className = 'voice-status-bar is-error';
      voiceStatus.textContent = "La transcription vocale n'est pas disponible dans ce navigateur. Utilisez Chrome ou Edge.";
      voiceStatus.style.display = 'flex';
    } else {
      const recognition = new SpeechRecognitionCtor();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = 'fr-FR';

      let isRecording = false;
      let baseText = '';

      const micIconOn = micBtn.querySelector('.mic-icon-on') as SVGElement;
      const micIconOff = micBtn.querySelector('.mic-icon-off') as SVGElement;
      const micText = micBtn.querySelector('.mic-text');

      function setRecording(rec: boolean) {
        isRecording = rec;
        micBtn?.classList.toggle('recording', rec);
        if (micIconOn && micIconOff) {
          micIconOn.style.display = rec ? 'none' : 'block';
          micIconOff.style.display = rec ? 'block' : 'none';
        }
        if (micText) micText.textContent = rec ? 'Arrêter' : 'Parler';

        if (rec) {
          voiceStatus.className = 'voice-status-bar';
          voiceStatus.innerHTML = '<span class="voice-wave"><span></span><span></span><span></span></span> Écoute en direct... Parlez normalement';
          voiceStatus.style.display = 'flex';
        } else {
          voiceStatus.style.display = 'none';
        }
      }

      recognition.onresult = (e: any) => {
        let interimTranscript = '';
        let finalTranscript = '';

        for (let i = e.resultIndex; i < e.results.length; i++) {
          const trans = e.results[i][0].transcript;
          if (e.results[i].isFinal) {
            finalTranscript += trans;
          } else {
            interimTranscript += trans;
          }
        }

        const glue = baseText ? ' ' : '';
        if (finalTranscript) {
          baseText = `${baseText}${glue}${finalTranscript}`.trim().slice(0, MAX_COMMENTAIRE);
          commentInput.value = baseText;
        } else if (interimTranscript) {
          commentInput.value = `${baseText}${glue}${interimTranscript}`.trim().slice(0, MAX_COMMENTAIRE);
        }

        if (charCountEl) {
          charCountEl.textContent = libelleCompteur(commentInput.value.length);
        }
      };

      recognition.onerror = (e: any) => {
        setRecording(false);
        voiceStatus.className = 'voice-status-bar is-error';
        if (e.error === 'not-allowed') {
          voiceStatus.textContent = "Accès micro refusé. Veuillez autoriser le micro.";
        } else if (e.error === 'audio-capture') {
          voiceStatus.textContent = "Aucun microphone n'est disponible sur cet appareil.";
        } else if (e.error === 'network') {
          voiceStatus.textContent = "La transcription vocale nécessite une connexion réseau.";
        } else if (e.error === 'no-speech') {
          voiceStatus.textContent = "Aucune parole détectée. Réessayez.";
        } else {
          voiceStatus.textContent = `Erreur de dictée vocale${e.error ? ` (${e.error})` : ''}.`;
        }
        voiceStatus.style.display = 'flex';
      };

      recognition.onend = () => {
        if (isRecording) setRecording(false);
      };

      micBtn.addEventListener('click', () => {
        if (!isRecording) {
          baseText = commentInput.value;
          try {
            recognition.start();
            setRecording(true);
          } catch (error: any) {
            setRecording(false);
            voiceStatus.className = 'voice-status-bar is-error';
            voiceStatus.textContent = error?.name === 'InvalidStateError'
              ? 'La transcription est déjà en cours. Réessayez dans un instant.'
              : "Impossible de démarrer le microphone. Vérifiez l'autorisation du navigateur.";
            voiceStatus.style.display = 'flex';
          }
        } else {
          recognition.stop();
          setRecording(false);
        }
      });
    }
  }

  // ================= ENVOI DU FORMULAIRE =================
  const btnSubmit = document.getElementById('btnSubmitFeedback') as HTMLButtonElement | null;
  const screenSentiment = document.getElementById('screen-sentiment');
  const screenSuccess = document.getElementById('screen-success');

  const contactTelInputEl = document.getElementById('contactTelInput') as HTMLInputElement | null;
  const contactTelErrorEl = document.getElementById('contactTelError');
  const submitErrorEl = document.getElementById('submitError');

  function afficherErreurTelephone(message: string | null) {
    if (contactTelErrorEl) {
      contactTelErrorEl.textContent = message || '';
      contactTelErrorEl.hidden = !message;
    }
    contactTelInputEl?.classList.toggle('is-invalid', !!message);
    if (message) contactTelInputEl?.focus();
  }

  function afficherErreurEnvoi(message: string | null) {
    if (submitErrorEl) {
      submitErrorEl.textContent = message || '';
      submitErrorEl.hidden = !message;
    }
  }

  contactTelInputEl?.addEventListener('input', () => afficherErreurTelephone(null));

  const consentCheckbox = document.getElementById('consentCheckbox') as HTMLInputElement | null;
  const consentErrorEl = document.getElementById('consentError');
  const champPiegeEl = document.getElementById('champSiteWeb') as HTMLInputElement | null;

  function afficherErreurConsentement(message: string | null) {
    if (consentErrorEl) {
      consentErrorEl.textContent = message || '';
      consentErrorEl.hidden = !message;
    }
    if (message) consentCheckbox?.focus();
  }
  consentCheckbox?.addEventListener('change', () => afficherErreurConsentement(null));

  // Un envoi = une clé. Elle est rejouée à l'identique si le client réessaie (coupure réseau, délai dépassé) :
  // l'API ne crée alors qu'UN feedback. Elle change seulement après un envoi confirmé.
  let cleEnvoi = nouvelleCleEnvoi();
  let envoiEnCours = false;

  btnSubmit?.addEventListener('click', async () => {
    if (envoiEnCours) return; // double clic / double appui : un seul envoi à la fois

    afficherErreurNote(null);
    afficherErreurCategorie(null);
    afficherErreurTelephone(null);
    afficherErreurConsentement(null);
    afficherErreurEnvoi(null);

    const probleme = verifierSaisie({
      niveau: sentimentSelectionne,
      categorieId: selectedCategorieId,
      souhaiteEtreRappele: wantsRecontact,
      telephone: contactTelInputEl?.value ?? '',
      consentement: consentCheckbox?.checked ?? false,
    });
    if (probleme) {
      if (probleme.champ === 'consentement') {
        afficherErreurConsentement(probleme.message);
      } else if (probleme.champ === 'telephone') {
        afficherErreurTelephone(probleme.message);
      } else if (probleme.champ === 'categorie') {
        afficherErreurCategorie(probleme.message);
        categorieSelect?.focus();
      } else {
        afficherErreurNote(probleme.message);
        (sentimentBtns[0] as HTMLElement | undefined)?.focus();
      }
      return;
    }

    envoiEnCours = true;
    const libelleBoutonInitial = btnSubmit.innerHTML;
    btnSubmit.disabled = true;
    btnSubmit.setAttribute('aria-busy', 'true');
    btnSubmit.innerHTML = '<span class="btn-spinner"></span><span>Envoi de votre avis...</span>';

    const payload = construirePayload({
      niveau: sentimentSelectionne,
      categorieId: selectedCategorieId,
      souhaiteEtreRappele: wantsRecontact,
      telephone: contactTelInputEl?.value ?? '',
      commentaire: commentInput?.value ?? '',
      cleEnvoi,
      consentement: consentCheckbox?.checked ?? false,
      piege: champPiegeEl?.value ?? '',
    });

    let confirme = false;
    try {
      const res = await fetchAPI(
        `/feedbacks/?qr_code=${encodeURIComponent(QR_CODE)}`,
        { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) },
        DELAI_ENVOI_MS,
      );

      if (res.ok) {
        // Seule une réponse 2xx confirme l'enregistrement : jamais de confirmation sur une erreur ou un délai.
        confirme = true;
        montrerEcran('succes');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        const created = await res.json().catch(() => null);
        if (created?.id && created?.nps_token) {
          afficherQuestionNPS(created.id, created.nps_token);
        }
      } else {
        const err = await res.json().catch(() => ({}));
        const erreurTelephone = res.status === 422 && Array.isArray(err.detail) &&
          err.detail.some((d: any) => Array.isArray(d?.loc) && d.loc.includes('contact_telephone'));
        if (erreurTelephone) {
          afficherErreurTelephone(MESSAGE_TELEPHONE_INVALIDE);
        } else if (res.status === 429) {
          afficherErreurEnvoi(`${messageEchecEnvoi('trop_de_demandes')} Votre avis n'a pas été envoyé.`);
        } else {
          afficherErreurEnvoi(messageEchecEnvoi(causeEchecHttp(res.status)));
        }
      }
    } catch (e: any) {
      console.error("Erreur d'envoi feedback:", e);
      afficherErreurEnvoi(messageEchecEnvoi(e?.name === 'AbortError' ? 'delai' : 'reseau'));
    } finally {
      envoiEnCours = false;
      btnSubmit.removeAttribute('aria-busy');
      if (confirme) {
        cleEnvoi = nouvelleCleEnvoi(); // l'envoi suivant sera un nouvel avis
      } else {
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = libelleBoutonInitial;
      }
    }
  });

  function afficherQuestionNPS(feedbackId: string, token: string) {
    const block = document.getElementById('npsBlock');
    const nomSpan = document.getElementById('npsAgenceNom');
    const scale = document.getElementById('npsScale');
    if (nomSpan) nomSpan.textContent = agenceNomCourant;
    if (block) block.style.display = 'flex';

    if (scale && !scale.dataset.rendered) {
      for (let note = 0; note <= 10; note++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'nps-btn';
        btn.textContent = String(note);
        btn.setAttribute(
          'aria-label',
          note === 0 ? '0 — Pas du tout probable' : note === 10 ? '10 — Très probable' : `Note ${note} sur 10`
        );
        btn.addEventListener('click', () => envoyerNPS(feedbackId, token, note));
        scale.appendChild(btn);
      }
      scale.dataset.rendered = '1';
    }

    document.getElementById('btnNpsSkip')?.addEventListener(
      'click',
      () => { if (block) block.style.display = 'none'; },
      { once: true }
    );
  }

  async function envoyerNPS(feedbackId: string, token: string, note: number) {
    const scale = document.getElementById('npsScale');
    const skip = document.getElementById('btnNpsSkip');
    const thanks = document.getElementById('npsThanks');

    scale?.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = true));

    try {
      await fetchAPI(`/feedbacks/${feedbackId}/nps`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nps_note: note, token }),
      });
    } catch (e) {
      console.warn('Envoi NPS non bloquant (réseau ou jeton expiré) :', e);
      // Tout échec est ignoré : on affiche quand même "Merci", jamais d'erreur visible.
    } finally {
      if (skip) skip.style.display = 'none';
      if (thanks) thanks.style.display = 'block';
    }
  }

  // ================= ACCUEIL ET « PARTAGER UNE IDÉE » =================
  const inputIdee = document.getElementById('inputIdee') as HTMLTextAreaElement | null;
  const ideeCharCount = document.getElementById('ideeCharCount');
  const ideeErrorEl = document.getElementById('ideeError');
  const btnSubmitIdee = document.getElementById('btnSubmitIdee') as HTMLButtonElement | null;
  const champIdeePiege = document.getElementById('champIdeeSiteWeb') as HTMLInputElement | null;

  function afficherErreurIdee(message: string | null) {
    if (ideeErrorEl) {
      ideeErrorEl.textContent = message || '';
      ideeErrorEl.hidden = !message;
    }
  }

  document.getElementById('btnChoixNote')?.addEventListener('click', () => {
    montrerEcran('formulaire');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  document.getElementById('btnChoixIdee')?.addEventListener('click', () => {
    montrerEcran('idee');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    inputIdee?.focus({ preventScroll: true });
  });
  document.getElementById('btnRetourIdee')?.addEventListener('click', () => {
    afficherErreurIdee(null);
    montrerEcran('accueil');
  });
  document.getElementById('btnIdeeAccueil')?.addEventListener('click', () => {
    montrerEcran('accueil');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  inputIdee?.addEventListener('input', () => {
    afficherErreurIdee(null);
    if (ideeCharCount) ideeCharCount.textContent = libelleCompteur(inputIdee.value.length);
  });

  // Un seul envoi à la fois (le verrou du bouton tient lieu de clé d'idempotence : l'API n'en a pas pour les idées).
  // En cas d'échec, le texte saisi reste en place et le client peut réessayer.
  let envoiIdeeEnCours = false;
  btnSubmitIdee?.addEventListener('click', async () => {
    if (envoiIdeeEnCours || !inputIdee) return;
    afficherErreurIdee(null);
    const probleme = verifierIdee(inputIdee.value);
    if (probleme) {
      afficherErreurIdee(probleme);
      inputIdee.focus();
      return;
    }

    envoiIdeeEnCours = true;
    const libelleInitial = btnSubmitIdee.innerHTML;
    btnSubmitIdee.disabled = true;
    btnSubmitIdee.setAttribute('aria-busy', 'true');
    btnSubmitIdee.innerHTML = '<span class="btn-spinner"></span><span>Envoi de votre idée...</span>';

    let confirme = false;
    try {
      const res = await fetchAPI(
        `/qr-codes/${encodeURIComponent(QR_CODE)}/suggestions`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(construirePayloadIdee(inputIdee.value, champIdeePiege?.value ?? '')),
        },
        DELAI_ENVOI_MS,
      );
      if (res.ok) {
        confirme = true;
        inputIdee.value = '';
        if (ideeCharCount) ideeCharCount.textContent = libelleCompteur(0);
        montrerEcran('idee_merci');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        afficherErreurIdee(messageEchecIdee(causeEchecHttp(res.status)));
      }
    } catch (e: any) {
      afficherErreurIdee(messageEchecIdee(e?.name === 'AbortError' ? 'delai' : 'reseau'));
    } finally {
      envoiIdeeEnCours = false;
      btnSubmitIdee.removeAttribute('aria-busy');
      btnSubmitIdee.disabled = false;
      btnSubmitIdee.innerHTML = libelleInitial;
    }
  });

  // Nouveau retour
  document.getElementById('btnNewFeedback')?.addEventListener('click', () => {
    sentimentBtns.forEach(b => {
      b.classList.remove('selected');
      b.setAttribute('aria-checked', 'false');
    });
    sentimentSelectionne = null;
    afficherErreurNote(null);

    selectedThemes.clear();
    renderThemesChips();

    selectedCategorieId = categoriesDisponibles.length === 1 ? categoriesDisponibles[0].id : null;
    renderCategorieOptions();

    if (commentInput) {
      commentInput.value = '';
      commentInput.placeholder = PLACEHOLDER_DEFAUT;
    }
    if (charCountEl) charCountEl.textContent = libelleCompteur(0);

    recontactNo?.click();
    const tel = document.getElementById('contactTelInput') as HTMLInputElement;
    if (tel) tel.value = '';
    afficherErreurTelephone(null);
    afficherErreurConsentement(null);
    if (consentCheckbox) consentCheckbox.checked = false;
    if (champPiegeEl) champPiegeEl.value = '';
    pointEntreeNiveaux(niveauxListe[0]);
    afficherErreurEnvoi(null);
    afficherErreurCategorie(null);
    document.getElementById('npsBlock')!.style.display = 'none';

    if (btnSubmit) {
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = `
        <span class="btn-text">Envoyer mon avis</span>
        <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      `;
    }

    montrerEcran('formulaire');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  setSector('telecom');
  void demarrer();
</script>
