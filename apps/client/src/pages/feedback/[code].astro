  }

  /* =========================================================
     CORPS DU FORMULAIRE
     ========================================================= */
  .form-flow {
    padding: clamp(16px, 3vh, 26px) clamp(16px, 3.5vw, 26px);
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2.5vh, 22px);
  }

  .screen-view {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.8vh, 24px);
    width: 100%;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .section-step-num {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #02302D;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
