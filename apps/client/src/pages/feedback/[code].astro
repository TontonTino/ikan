</style>

<script>
  import { normaliserTelephone, MESSAGE_TELEPHONE_INVALIDE } from '../../utils/telephone';
  import {
    DELAI_ENVOI_MS,
    DELAI_VALIDATION_MS,
    MAX_COMMENTAIRE,
    NIVEAUX,
    causeEchecHttp,
    construirePayload,
    etatQrDepuisStatut,
    extraireCodeQr,
    indexNiveauSuivant,
    libelleCompteur,
    libelleConsentement,
    messageEchecEnvoi,
    messageEchecIdee,
    construirePayloadIdee,
    nouvelleCleEnvoi,
    verifierIdee,
    verifierSaisie,
  } from '../../utils/parcours';

  // Navigation & Paramètres
  const DEFAULT_API_URL = 'https://ikan-772d.onrender.com/api/v1';
  const pageOuter = document.querySelector('.page-outer') as HTMLElement | null;
  const API_URL = pageOuter?.dataset.apiUrl || DEFAULT_API_URL;
  const qrDejaValideParServeur = pageOuter?.dataset.qrValide === '1';

  // Requête API avec délai maximal. AUCUN repli vers un autre serveur : un avis ne part que vers l'API configurée
  // (avant : bascule silencieuse vers l'API de production, y compris pour un POST).
  async function fetchAPI(endpoint: string, options: RequestInit = {}, delaiMs: number = DELAI_VALIDATION_MS) {
    const controleur = new AbortController();
    const minuteur = window.setTimeout(() => controleur.abort(), delaiMs);
    try {
      return await fetch(`${API_URL}${endpoint}`, { ...options, signal: controleur.signal });
    } finally {
      window.clearTimeout(minuteur);
    }
  }

  // Code du QR : aucun repli sur une agence par défaut (voir extraireCodeQr).
  const QR_CODE = extraireCodeQr(window.location.pathname, window.location.search) || '';

  // ================= ÉCRANS : formulaire / chargement / erreur / succès =================
  type NomEcran = 'accueil' | 'idee' | 'idee_merci' | 'formulaire' | 'chargement' | 'erreur' | 'succes';
  function montrerEcran(nom: NomEcran) {
    const ecrans: Record<NomEcran, string> = {
      accueil: 'screen-accueil',
      idee: 'screen-idee',
      idee_merci: 'screen-idee-merci',
      formulaire: 'screen-sentiment',
      chargement: 'screen-chargement',
      erreur: 'screen-erreur',
      succes: 'screen-success',
    };
    (Object.keys(ecrans) as NomEcran[]).forEach((cle) => {
      const el = document.getElementById(ecrans[cle]);
      if (el) el.style.display = cle === nom ? 'flex' : 'none';
    });
  }

  function afficherEcranErreur(titre: string, message: string, peutReessayer: boolean) {
    const t = document.getElementById('erreurTitre');
    const m = document.getElementById('erreurMessage');
    const b = document.getElementById('btnReessayerQr') as HTMLButtonElement | null;
    if (t) t.textContent = titre;
    if (m) m.textContent = message;
    if (b) b.hidden = !peutReessayer;
    montrerEcran('erreur');
  }

  // ================= THÈMES SECTORIELS PAR ENTREPRISE CIBLE =================
  type SectorType = 'telecom' | 'banque' | 'restaurant' | 'general';

  interface SectorConfig {
    label: string;
    icon: string;
    themes: string[];
  }

  const SECTORS_DATA: Record<SectorType, SectorConfig> = {
    telecom: {
      label: 'Télécom',
      icon: '📱',
      themes: [
        '⚡ Rapidité guichet',
        '📶 Réseau & SIM',
        '🤝 Accueil & Conseil',
        '💳 Forfaits & Factures',
        '📱 Offres & Téléphones',
        '🏢 Confort de l’agence',
      ],
    },
    banque: {
      label: 'Banque',
      icon: '🏦',
      themes: [
        '🤝 Écoute conseiller',
        '⚡ Temps d’attente',
        '🏧 DAB & Guichet',
        '📄 Clarté démarches',
        '🔒 Sécurité & Discrétion',
        '🏢 Espace propre & calme',
      ],
    },
    restaurant: {
      label: 'Restaurant',
      icon: '🍽️',
      themes: [
        '🍽️ Qualité des plats',
        '⚡ Vitesse de service',
        '🤝 Amabilité équipe',
        '🧹 Propreté & Hygiène',
        '🎵 Cadre & Ambiance',
        '💰 Rapport qualité/prix',
      ],
    },
    general: {
      label: 'Commerce & Services',
      icon: '🏢',
      themes: [
        '🤝 Accueil & Sourire',
        '⚡ Prise en charge rapide',
        '🏷️ Choix & Disponibilité',
        '💡 Qualité des conseils',
        '🏢 Propreté des lieux',
        '💳 Facilité de paiement',
      ],
    },
  };

  let currentSector: SectorType = 'telecom';
  const selectedThemes = new Set<string>();

  // ================= CATÉGORIE DE L'AVIS (définie par le CX Manager, par agence) =================
  interface Categorie {
    id: string;
    nom: string;
  }

  let categoriesDisponibles: Categorie[] = [];
  let selectedCategorieId: string | null = null;

  const categorieSelect = document.getElementById('categorieSelect') as HTMLSelectElement | null;

  function renderCategorieOptions() {
    if (!categorieSelect) return;
    categorieSelect.innerHTML = '';
    categorieSelect.disabled = false;

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.disabled = true;
    placeholder.selected = !selectedCategorieId;
    placeholder.textContent = 'Sélectionnez une catégorie';
    categorieSelect.appendChild(placeholder);

    categoriesDisponibles.forEach(cat => {
      const option = document.createElement('option');
      option.value = cat.id;
      option.textContent = cat.nom;
      option.selected = selectedCategorieId === cat.id;
      categorieSelect.appendChild(option);
    });
  }

  const categorieErrorEl = document.getElementById('categorieError');
  const btnRecharger = document.getElementById('btnRecharger') as HTMLButtonElement | null;

  function afficherErreurCategorie(message: string | null) {
    if (categorieErrorEl) {
      categorieErrorEl.textContent = message || '';
      categorieErrorEl.hidden = !message;
    }
    if (btnRecharger) btnRecharger.hidden = !message || !message.startsWith('Impossible');
  }

  categorieSelect?.addEventListener('change', () => {
    selectedCategorieId = categorieSelect.value || null;
    afficherErreurCategorie(null);
  });

  async function loadCategories() {
    if (!categorieSelect) return;
    afficherErreurCategorie(null);
    categorieSelect.disabled = true;
    categorieSelect.innerHTML = '<option value="" disabled selected>Chargement des catégories...</option>';
    try {
      const res = await fetchAPI(`/qr-codes/${encodeURIComponent(QR_CODE)}/categories`);
      if (res.status === 404) {
        afficherEcranErreur(
          'QR Code non reconnu',
          "Ce QR code n'est pas reconnu ou n'est plus actif. Merci de prévenir l'agence, ou scannez de nouveau le QR code affiché en agence.",
          false,
        );
        return;
      }
      if (res.status === 429) {
        categorieSelect.innerHTML = '<option value="" disabled selected>Catégories indisponibles</option>';
        afficherErreurCategorie(`Impossible de charger les catégories : ${messageEchecEnvoi('trop_de_demandes')}`);
        return;
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      categoriesDisponibles = await res.json();
      // Une seule catégorie : inutile de demander au client de la choisir.
      if (categoriesDisponibles.length === 1) selectedCategorieId = categoriesDisponibles[0].id;
      renderCategorieOptions();
      if (categoriesDisponibles.length === 0) {
        afficherErreurCategorie("Impossible de charger les catégories de cette agence. Appuyez sur Réessayer.");
      }
    } catch (e) {
      categorieSelect.innerHTML = '<option value="" disabled selected>Catégories indisponibles</option>';
      afficherErreurCategorie('Impossible de charger les catégories. Vérifiez votre connexion puis appuyez sur Réessayer.');
    }
  }

  btnRecharger?.addEventListener('click', () => { void loadCategories(); });

  function detectSectorFromText(text: string): SectorType {
    const t = text.toLowerCase();
    if (t.includes('orange') || t.includes('telecom') || t.includes('moov') || t.includes('tel') || t.includes('mobile') || t.includes('mtn')) {
      return 'telecom';
    }
    if (t.includes('banque') || t.includes('bank') || t.includes('boa') || t.includes('ecobank') || t.includes('bici') || t.includes('finance') || t.includes('sg') || t.includes('attijari') || t.includes('credit')) {
      return 'banque';
    }
    if (t.includes('resto') || t.includes('restaurant') || t.includes('cafe') || t.includes('café') || t.includes('grill') || t.includes('lounge') || t.includes('bistrot') || t.includes('food')) {
      return 'restaurant';
    }
    return 'general';
  }

  // Nom de l'agence courante, réutilisé par la question NPS après l'envoi.
  let agenceNomCourant = 'cette agence';

  // Durée de conservation (mois) lue dans la configuration de la plateforme via /validate : texte de la case de
  // consentement. Inconnue => le recontact n'est pas proposé (jamais de durée écrite en dur).
  const consentTextEl = document.getElementById('consentText');
  const recontactSection = document.getElementById('recontactSection');
  function appliquerRetention(valeur: unknown) {
    const texte = libelleConsentement(valeur);
    if (consentTextEl) consentTextEl.textContent = texte || '';
    if (recontactSection) recontactSection.hidden = !texte;
  }
  appliquerRetention(pageOuter?.dataset.retentionMois);

  // Validation du QR Code côté navigateur (le serveur a déjà tenté une validation rapide au rendu de la page)
  async function validerQr() {
    try {
      const res = await fetchAPI(`/qr-codes/${encodeURIComponent(QR_CODE)}/validate`);
      if (res.ok) {
        const data = await res.json();
        const agencyName = data.agence_nom || 'AGENCE';
        agenceNomCourant = agencyName;
        const agencyBadge = document.getElementById('agencyBadgeText');
        if (agencyBadge) {
          agencyBadge.textContent = agencyName;
        }
        const accueilAgence = document.getElementById('accueilAgenceNom');
        if (accueilAgence) accueilAgence.textContent = agencyName;
        document.title = `Votre avis — ${agencyName}`;
        appliquerRetention(data.retention_mois);
        setSector(detectSectorFromText(`${agencyName} ${QR_CODE}`));
      }
      return etatQrDepuisStatut(res.status);
    } catch (e) {
      return etatQrDepuisStatut(null);
    }
  }

  // Démarrage : QR absent → erreur ; QR invalide → erreur ; service injoignable → erreur récupérable ; sinon formulaire.
  async function demarrer() {
    if (!document.getElementById('screen-sentiment')) return; // page d'erreur déjà rendue par le serveur
    if (!QR_CODE) {
      afficherEcranErreur(
        'QR Code non détecté',
        "Aucun code QR n'a été détecté dans ce lien. Scannez le QR code affiché en agence.",
        false,
      );
      return;
    }
    if (qrDejaValideParServeur) {
      agenceNomCourant = document.getElementById('agencyBadgeText')?.textContent?.trim() || agenceNomCourant;
    } else {
      montrerEcran('chargement');
      const etat = await validerQr();
      if (etat === 'invalide') {
        afficherEcranErreur(
          'QR Code non reconnu',
          "Ce QR code n'est pas reconnu ou n'est plus actif. Merci de prévenir l'agence, ou scannez de nouveau le QR code affiché en agence.",
          false,
        );
        return;
      }
      if (etat === 'trop_de_demandes') {
        afficherEcranErreur('Un instant', messageEchecEnvoi('trop_de_demandes'), true);
        return;
      }
      if (etat === 'indisponible') {
        afficherEcranErreur(
          'Service momentanément indisponible',
          'Impossible de joindre le service pour le moment. Vérifiez votre connexion puis réessayez.',
          true,
        );
        return;
      }
    }
    montrerEcran('accueil');
    await loadCategories();
  }

  document.getElementById('btnReessayerQr')?.addEventListener('click', () => { void demarrer(); });

  // Rendu dynamique des chips
  const themesChipsContainer = document.getElementById('themesChipsContainer');
  const sectorPillIcon = document.getElementById('sectorPillIcon');
  const sectorPillLabel = document.getElementById('sectorPillLabel');
  const sectorSwitchBtn = document.getElementById('sectorSwitchBtn');
  const sectorMenuPopover = document.getElementById('sectorMenuPopover');

  function renderThemesChips() {
    if (!themesChipsContainer) return;
    themesChipsContainer.innerHTML = '';
    const config = SECTORS_DATA[currentSector];

    config.themes.forEach(theme => {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'theme-chip' + (selectedThemes.has(theme) ? ' is-selected' : '');
      chip.innerHTML = `
        <svg class="chip-check" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>${theme}</span>
      `;

      chip.addEventListener('click', () => {
        if (selectedThemes.has(theme)) {
          selectedThemes.delete(theme);
          chip.classList.remove('is-selected');
        } else {
          selectedThemes.add(theme);
          chip.classList.add('is-selected');
        }
      });

      themesChipsContainer.appendChild(chip);
    });
  }

  function setSector(sector: SectorType) {
    currentSector = sector;
    const config = SECTORS_DATA[sector];
    if (sectorPillIcon) sectorPillIcon.textContent = config.icon;
    if (sectorPillLabel) sectorPillLabel.textContent = config.label;

    document.querySelectorAll('.sector-choice-btn').forEach(btn => {
      const s = (btn as HTMLElement).dataset.sector;
      btn.classList.toggle('is-active', s === sector);
    });

    selectedThemes.clear();
    renderThemesChips();
  }

  sectorSwitchBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = sectorMenuPopover?.hasAttribute('hidden');
    if (isHidden) {
      sectorMenuPopover?.removeAttribute('hidden');
      sectorSwitchBtn.setAttribute('aria-expanded', 'true');
    } else {
      sectorMenuPopover?.setAttribute('hidden', '');
      sectorSwitchBtn.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('click', (e) => {
    if (sectorMenuPopover && !sectorMenuPopover.contains(e.target as Node) && e.target !== sectorSwitchBtn) {
      sectorMenuPopover.setAttribute('hidden', '');
      sectorSwitchBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  document.querySelectorAll('.sector-choice-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const sector = (btn as HTMLElement).dataset.sector as SectorType;
      if (sector && SECTORS_DATA[sector]) {
        setSector(sector);
        sectorMenuPopover?.setAttribute('hidden', '');
        sectorSwitchBtn?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // ================= 5 NIVEAUX DE SENTIMENT =================
  // Aucun niveau n'est présélectionné : le client choisit sa note (voir NIVEAUX dans utils/parcours.ts).
  let sentimentSelectionne: string | null = null;

  const PLACEHOLDER_DEFAUT = 'Partagez votre ressenti ou une remarque...';
  const PLACEHOLDERS: Record<string, string> = {
    mauvais: "Expliquez-nous ce qui n'a pas été pour que nous puissions rectifier le tir...",
    passable: "Qu'est-ce qui aurait pu rendre votre passage meilleur aujourd'hui ?",
    neutre: 'Partagez votre ressenti, vos remarques ou suggestions...',
    bien: "Partagez ce qui vous a plu ou vos suggestions d'amélioration...",
    excellente: "Qu'avez-vous particulièrement apprécié ? Un collaborateur à féliciter ?",
  };

  const sentimentBtns = document.querySelectorAll('.sentiment-tile');
  const commentInput = document.getElementById('inputCommentaire') as HTMLTextAreaElement | null;
  const ratingErrorEl = document.getElementById('ratingError');

  function afficherErreurNote(message: string | null) {
    if (ratingErrorEl) {
      ratingErrorEl.textContent = message || '';
      ratingErrorEl.hidden = !message;
    }
  }

  // Groupe radio à tabindex itinérant : UNE seule tabulation pour entrer (le niveau choisi, sinon le premier), puis
  // flèches / Début / Fin pour se déplacer, Espace ou Entrée pour choisir (clic natif d'un <button>).
  const niveauxListe = Array.from(sentimentBtns) as HTMLElement[];
  function pointEntreeNiveaux(cible: HTMLElement) {
    niveauxListe.forEach((b) => b.setAttribute('tabindex', b === cible ? '0' : '-1'));
  }
  niveauxListe.forEach((btn, index) => {
    btn.addEventListener('keydown', (e) => {
      const suivant = indexNiveauSuivant(index, (e as KeyboardEvent).key, niveauxListe.length);
      if (suivant === null) return;
      e.preventDefault();
      pointEntreeNiveaux(niveauxListe[suivant]);
      niveauxListe[suivant].focus();
    });
  });

  sentimentBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sentimentBtns.forEach(b => {
        b.classList.remove('selected');
        b.setAttribute('aria-checked', 'false');
      });

      btn.classList.add('selected');
      btn.setAttribute('aria-checked', 'true');
      pointEntreeNiveaux(btn as HTMLElement);

      const choix = (btn as HTMLElement).dataset.sentiment || '';
      sentimentSelectionne = NIVEAUX[choix] ? choix : null;
      afficherErreurNote(null);
      if (commentInput && sentimentSelectionne && !commentInput.value.trim()) {
        commentInput.placeholder = PLACEHOLDERS[sentimentSelectionne] || PLACEHOLDER_DEFAUT;
