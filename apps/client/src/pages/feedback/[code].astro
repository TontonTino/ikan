<script>
  // Navigation & Paramètres
  const DEFAULT_API_URL = 'https://ikanai-api.onrender.com/api/v1';
  const pageOuter = document.querySelector('.page-outer') as HTMLElement | null;
  let API_URL = pageOuter?.dataset.apiUrl || DEFAULT_API_URL;

  // Requête API résiliente avec bascule automatique vers Render en cas d'échec local
  async function fetchAPI(endpoint: string, options: RequestInit = {}) {
    try {
      const res = await fetch(`${API_URL}${endpoint}`, options);
      return res;
    } catch (err) {
      if (API_URL !== DEFAULT_API_URL) {
        console.warn(`API locale injoignable, bascule vers ${DEFAULT_API_URL}`);
        API_URL = DEFAULT_API_URL;
        return await fetch(`${DEFAULT_API_URL}${endpoint}`, options);
      }
      throw err;
    }
  }

  const pathParts = window.location.pathname.split('/').filter(Boolean);
  const urlParams = new URLSearchParams(window.location.search);
  let QR_CODE = urlParams.get('qr') || urlParams.get('code') || '';

  if (!QR_CODE && pathParts.length >= 2 && pathParts[0] === 'feedback') {
    QR_CODE = decodeURIComponent(pathParts[1]);
  } else if (!QR_CODE && pathParts.length === 1 && pathParts[0] !== 'feedback') {
    QR_CODE = decodeURIComponent(pathParts[0]);
  }

  if (!QR_CODE) {
    QR_CODE = 'QR-ORANGE-TUNIS-01';
  }

  // ================= THÈMES SECTORIELS PAR ENTREPRISE CIBLE =================
  type SectorType = 'telecom' | 'banque' | 'restaurant' | 'general';

  interface SectorConfig {
    label: string;
    icon: string;
    themes: string[];
  }

  const SECTORS_DATA: Record<SectorType, SectorConfig> = {
    telecom: {
      label: 'Télécom',
      icon: '📱',
      themes: [
        '⚡ Rapidité guichet',
        '📶 Réseau & SIM',
        '🤝 Accueil & Conseil',
        '💳 Forfaits & Factures',
        '📱 Offres & Téléphones',
        '🏢 Confort de l’agence',
      ],
    },
    banque: {
      label: 'Banque',
      icon: '🏦',
      themes: [
        '🤝 Écoute conseiller',
        '⚡ Temps d’attente',
        '🏧 DAB & Guichet',
        '📄 Clarté démarches',
        '🔒 Sécurité & Discrétion',
        '🏢 Espace propre & calme',
      ],
    },
    restaurant: {
      label: 'Restaurant',
      icon: '🍽️',
      themes: [
        '🍽️ Qualité des plats',
        '⚡ Vitesse de service',
        '🤝 Amabilité équipe',
        '🧹 Propreté & Hygiène',
        '🎵 Cadre & Ambiance',
        '💰 Rapport qualité/prix',
      ],
    },
    general: {
      label: 'Commerce & Services',
      icon: '🏢',
      themes: [
        '🤝 Accueil & Sourire',
        '⚡ Prise en charge rapide',
        '🏷️ Choix & Disponibilité',
        '💡 Qualité des conseils',
        '🏢 Propreté des lieux',
        '💳 Facilité de paiement',
      ],
    },
  };

  let currentSector: SectorType = 'telecom';
  const selectedThemes = new Set<string>();

  function detectSectorFromText(text: string): SectorType {
    const t = text.toLowerCase();
    if (t.includes('orange') || t.includes('telecom') || t.includes('moov') || t.includes('tel') || t.includes('mobile') || t.includes('mtn')) {
      return 'telecom';
    }
    if (t.includes('banque') || t.includes('bank') || t.includes('boa') || t.includes('ecobank') || t.includes('bici') || t.includes('finance') || t.includes('sg') || t.includes('attijari') || t.includes('credit')) {
      return 'banque';
    }
    if (t.includes('resto') || t.includes('restaurant') || t.includes('cafe') || t.includes('café') || t.includes('grill') || t.includes('lounge') || t.includes('bistrot') || t.includes('food')) {
      return 'restaurant';
    }
    return 'general';
  }

  // Hydratation / Validation QR Code côté client
  async function hydrateAgency() {
    try {
      const res = await fetchAPI(`/qr-codes/${encodeURIComponent(QR_CODE)}/validate`);
      if (res.ok) {
        const data = await res.json();
        const agencyName = data.agence_nom || 'AGENCE';
        const agencyBadge = document.getElementById('agencyBadgeText');
        if (agencyBadge) {
          agencyBadge.textContent = agencyName;
        }
        document.title = `Votre avis — ${agencyName}`;

        // Détection automatique du secteur
        const detected = detectSectorFromText(`${agencyName} ${QR_CODE}`);
        setSector(detected);
      }
    } catch (e) {
      console.warn("Validation QR Code côté client non bloquante");
    }
  }

  // Rendu dynamique des chips
  const themesChipsContainer = document.getElementById('themesChipsContainer');
  const sectorPillIcon = document.getElementById('sectorPillIcon');
  const sectorPillLabel = document.getElementById('sectorPillLabel');
  const sectorSwitchBtn = document.getElementById('sectorSwitchBtn');
  const sectorMenuPopover = document.getElementById('sectorMenuPopover');

  function renderThemesChips() {
    if (!themesChipsContainer) return;
    themesChipsContainer.innerHTML = '';
    const config = SECTORS_DATA[currentSector];

    config.themes.forEach(theme => {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'theme-chip' + (selectedThemes.has(theme) ? ' is-selected' : '');
      chip.innerHTML = `
        <svg class="chip-check" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>${theme}</span>
      `;

      chip.addEventListener('click', () => {
        if (selectedThemes.has(theme)) {
          selectedThemes.delete(theme);
          chip.classList.remove('is-selected');
        } else {
          selectedThemes.add(theme);
          chip.classList.add('is-selected');
        }
      });

      themesChipsContainer.appendChild(chip);
    });
  }

  function setSector(sector: SectorType) {
    currentSector = sector;
    const config = SECTORS_DATA[sector];
    if (sectorPillIcon) sectorPillIcon.textContent = config.icon;
    if (sectorPillLabel) sectorPillLabel.textContent = config.label;

    document.querySelectorAll('.sector-choice-btn').forEach(btn => {
      const s = (btn as HTMLElement).dataset.sector;
      btn.classList.toggle('is-active', s === sector);
    });

    selectedThemes.clear();
    renderThemesChips();
  }

  sectorSwitchBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = sectorMenuPopover?.hasAttribute('hidden');
    if (isHidden) {
      sectorMenuPopover?.removeAttribute('hidden');
      sectorSwitchBtn.setAttribute('aria-expanded', 'true');
    } else {
      sectorMenuPopover?.setAttribute('hidden', '');
      sectorSwitchBtn.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('click', (e) => {
    if (sectorMenuPopover && !sectorMenuPopover.contains(e.target as Node) && e.target !== sectorSwitchBtn) {
      sectorMenuPopover.setAttribute('hidden', '');
      sectorSwitchBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  document.querySelectorAll('.sector-choice-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const sector = (btn as HTMLElement).dataset.sector as SectorType;
      if (sector && SECTORS_DATA[sector]) {
        setSector(sector);
        sectorMenuPopover?.setAttribute('hidden', '');
        sectorSwitchBtn?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // ================= 5 NIVEAUX DE SENTIMENT =================
  let sentimentSelectionne: string = 'bien';

  const sentimentDataMap: Record<string, { note: number; apiSentiment: string; label: string; placeholder: string }> = {
    mauvais: {
      note: 1,
      apiSentiment: 'negatif',
      label: 'Mauvais',
      placeholder: "Expliquez-nous ce qui n'a pas été pour que nous puissions rectifier le tir...",
    },
    passable: {
      note: 2,
      apiSentiment: 'negatif',
      label: 'Passable',
      placeholder: "Qu'est-ce qui aurait pu rendre votre passage meilleur aujourd'hui ?",
    },
    neutre: {
      note: 3,
      apiSentiment: 'neutre',
      label: 'Neutre',
      placeholder: "Partagez votre ressenti, vos remarques ou suggestions...",
    },
    bien: {
      note: 4,
      apiSentiment: 'positif',
      label: 'Bien',
      placeholder: "Partagez ce qui vous a plu ou vos suggestions d'amélioration...",
    },
    excellente: {
      note: 5,
      apiSentiment: 'positif',
      label: 'Excellente',
      placeholder: "Qu'avez-vous particulièrement apprécié ? Un collaborateur à féliciter ?",
    },
  };

  const sentimentBtns = document.querySelectorAll('.sentiment-tile');
  const selectedLabelEl = document.getElementById('selectedSentimentLabel');
  const commentInput = document.getElementById('inputCommentaire') as HTMLTextAreaElement | null;

  sentimentBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sentimentBtns.forEach(b => {
        b.classList.remove('selected');
        b.setAttribute('aria-checked', 'false');
      });

      btn.classList.add('selected');
      btn.setAttribute('aria-checked', 'true');

      sentimentSelectionne = (btn as HTMLElement).dataset.sentiment || 'bien';
      const meta = sentimentDataMap[sentimentSelectionne];

      if (selectedLabelEl && meta) {
        selectedLabelEl.textContent = meta.label;
      }
      if (commentInput && meta && !commentInput.value.trim()) {
        commentInput.placeholder = meta.placeholder;
      }
    });
  });

  // ================= SÉLECTEUR RECONTACT =================
  const recontactNo = document.getElementById('recontactNo');
  const recontactYes = document.getElementById('recontactYes');
  const contactFieldsPanel = document.getElementById('contactFieldsPanel');
  let wantsRecontact = false;

  recontactNo?.addEventListener('click', () => {
    wantsRecontact = false;
    recontactNo.classList.add('is-active');
    recontactYes?.classList.remove('is-active');
    if (contactFieldsPanel) contactFieldsPanel.hidden = true;
  });

  recontactYes?.addEventListener('click', () => {
    wantsRecontact = true;
    recontactYes.classList.add('is-active');
    recontactNo?.classList.remove('is-active');
    if (contactFieldsPanel) contactFieldsPanel.hidden = false;
  });

  // ================= COMPTEUR DE CARACTÈRES =================
  const charCountEl = document.getElementById('charCount');
  commentInput?.addEventListener('input', () => {
    if (charCountEl && commentInput) {
      charCountEl.textContent = `${commentInput.value.length} / 500`;
    }
  });

  // ================= DICTÉE VOCALE (WEB SPEECH API) =================
  const micBtn = document.getElementById('micBtnCommentaire') as HTMLButtonElement | null;
  const voiceStatus = document.getElementById('voiceStatusCommentaire');

  if (micBtn && commentInput && voiceStatus) {
    const SpeechRecognitionCtor =
      (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;

    if (!SpeechRecognitionCtor) {
      micBtn.disabled = true;
      micBtn.title = "La reconnaissance vocale n'est pas supportée par ce navigateur.";
      voiceStatus.className = 'voice-status-bar is-error';
      voiceStatus.textContent = "La transcription vocale n'est pas disponible dans ce navigateur. Utilisez Chrome ou Edge.";
      voiceStatus.style.display = 'flex';
    } else {
      const recognition = new SpeechRecognitionCtor();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = 'fr-FR';

      let isRecording = false;
      let baseText = '';

      const micIconOn = micBtn.querySelector('.mic-icon-on') as SVGElement;
      const micIconOff = micBtn.querySelector('.mic-icon-off') as SVGElement;
      const micText = micBtn.querySelector('.mic-text');

      function setRecording(rec: boolean) {
        isRecording = rec;
        micBtn?.classList.toggle('recording', rec);
        if (micIconOn && micIconOff) {
          micIconOn.style.display = rec ? 'none' : 'block';
          micIconOff.style.display = rec ? 'block' : 'none';
        }
        if (micText) micText.textContent = rec ? 'Arrêter' : 'Parler';

        if (rec) {
          voiceStatus.className = 'voice-status-bar';
          voiceStatus.innerHTML = '<span class="voice-wave"><span></span><span></span><span></span></span> Écoute en direct... Parlez normalement';
          voiceStatus.style.display = 'flex';
        } else {
          voiceStatus.style.display = 'none';
        }
      }

      recognition.onresult = (e: any) => {
        let interimTranscript = '';
        let finalTranscript = '';

        for (let i = e.resultIndex; i < e.results.length; i++) {
          const trans = e.results[i][0].transcript;
          if (e.results[i].isFinal) {
            finalTranscript += trans;
          } else {
            interimTranscript += trans;
          }
        }

        const glue = baseText ? ' ' : '';
        if (finalTranscript) {
          baseText = `${baseText}${glue}${finalTranscript}`.trim().slice(0, 500);
          commentInput.value = baseText;
        } else if (interimTranscript) {
          commentInput.value = `${baseText}${glue}${interimTranscript}`.trim().slice(0, 500);
        }

        if (charCountEl) {
          charCountEl.textContent = `${commentInput.value.length} / 500`;
        }
      };

      recognition.onerror = (e: any) => {
        setRecording(false);
        voiceStatus.className = 'voice-status-bar is-error';
        if (e.error === 'not-allowed') {
          voiceStatus.textContent = "Accès micro refusé. Veuillez autoriser le micro.";
        } else if (e.error === 'audio-capture') {
          voiceStatus.textContent = "Aucun microphone n'est disponible sur cet appareil.";
        } else if (e.error === 'network') {
          voiceStatus.textContent = "La transcription vocale nécessite une connexion réseau.";
        } else if (e.error === 'no-speech') {
          voiceStatus.textContent = "Aucune parole détectée. Réessayez.";
        } else {
          voiceStatus.textContent = `Erreur de dictée vocale${e.error ? ` (${e.error})` : ''}.`;
        }
        voiceStatus.style.display = 'flex';
      };

      recognition.onend = () => {
        if (isRecording) setRecording(false);
      };

      micBtn.addEventListener('click', () => {
        if (!isRecording) {
          baseText = commentInput.value;
          try {
            recognition.start();
            setRecording(true);
          } catch (error: any) {
            setRecording(false);
            voiceStatus.className = 'voice-status-bar is-error';
            voiceStatus.textContent = error?.name === 'InvalidStateError'
              ? 'La transcription est déjà en cours. Réessayez dans un instant.'
              : "Impossible de démarrer le microphone. Vérifiez l'autorisation du navigateur.";
            voiceStatus.style.display = 'flex';
          }
        } else {
          recognition.stop();
          setRecording(false);
        }
      });
    }
  }

  // ================= ENVOI DU FORMULAIRE =================
  const btnSubmit = document.getElementById('btnSubmitFeedback') as HTMLButtonElement | null;
  const screenSentiment = document.getElementById('screen-sentiment');
  const screenSuccess = document.getElementById('screen-success');

  btnSubmit?.addEventListener('click', async () => {
    const commentaireTexte = commentInput?.value.trim() || '';
    const contactTel = (document.getElementById('contactTelInput') as HTMLInputElement)?.value.trim() || null;

    if (wantsRecontact && !contactTel) {
      alert("Veuillez renseigner un numéro de téléphone pour être recontacté.");
      return;
    }

    btnSubmit.disabled = true;
    btnSubmit.innerHTML = '<span class="btn-spinner"></span><span>Envoi de votre avis...</span>';

    const sentimentMeta = sentimentDataMap[sentimentSelectionne] || sentimentDataMap.bien;
    const themesArray = Array.from(selectedThemes);

    let finalCommentaire = commentaireTexte;
    if (themesArray.length > 0) {
      const themesTag = `[Thèmes : ${themesArray.join(', ')}]`;
      finalCommentaire = finalCommentaire ? `${themesTag}\n${finalCommentaire}` : themesTag;
    }

    const payload = {
      sentiment: sentimentMeta.apiSentiment,
      note: sentimentMeta.note,
      commentaire: finalCommentaire || null,
      suggestion: null,
      souhaite_etre_rappele: wantsRecontact,
      contact_nom: null,
      contact_telephone: wantsRecontact ? contactTel : null,
      contact_email: null,
      secteur: currentSector,
      themes: themesArray,
    };

    try {
      const res = await fetchAPI(`/feedbacks/?qr_code=${encodeURIComponent(QR_CODE)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        if (screenSentiment) screenSentiment.style.display = 'none';
        if (screenSuccess) screenSuccess.style.display = 'flex';
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        const err = await res.json().catch(() => ({}));
        alert(`Information : ${err.detail || 'Votre avis a été pris en compte.'}`);
        if (screenSentiment) screenSentiment.style.display = 'none';
        if (screenSuccess) screenSuccess.style.display = 'flex';
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    } catch (e) {
      console.error("Erreur d'envoi feedback:", e);
      // Mode tolérant hors-ligne pour ne pas frustrer le client
      if (screenSentiment) screenSentiment.style.display = 'none';
      if (screenSuccess) screenSuccess.style.display = 'flex';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // Nouveau retour
  document.getElementById('btnNewFeedback')?.addEventListener('click', () => {
    // Reset sentiment to 'bien'
    sentimentBtns.forEach(b => {
      b.classList.remove('selected');
      b.setAttribute('aria-checked', 'false');
      if ((b as HTMLElement).dataset.sentiment === 'bien') {
        b.classList.add('selected');
        b.setAttribute('aria-checked', 'true');
      }
    });
    sentimentSelectionne = 'bien';
    if (selectedLabelEl) selectedLabelEl.textContent = 'Bien';

    selectedThemes.clear();
    renderThemesChips();

    if (commentInput) {
      commentInput.value = '';
      commentInput.placeholder = sentimentDataMap.bien.placeholder;
    }
    if (charCountEl) charCountEl.textContent = '0 / 500';

    recontactNo?.click();
    const tel = document.getElementById('contactTelInput') as HTMLInputElement;
    if (tel) tel.value = '';

    if (btnSubmit) {
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = `
        <span class="btn-text">Envoyer mon avis</span>
        <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      `;
    }

    if (screenSuccess) screenSuccess.style.display = 'none';
    if (screenSentiment) screenSentiment.style.display = 'flex';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Initialisation
  setSector('telecom');
  hydrateAgency();
</script>