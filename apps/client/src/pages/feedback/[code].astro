---
/**
 * Page de Feedback Client QR — IKAN AI
 * URL : /feedback/{code}
 */
import FeedbackLayout from '../../layouts/FeedbackLayout.astro';
import { ipVisiteur } from '../../utils/securite';

const { code } = Astro.params;
const DEFAULT_API_URL = 'https://ikan-772d.onrender.com/api/v1';
const SSR_API_URL = import.meta.env.PUBLIC_API_URL || DEFAULT_API_URL;

let agenceInfo: { agence_nom?: string; code?: string; actif?: boolean; retention_mois?: number } | null = null;
let erreur: string | null = null;

const cleanCode = (code || '').trim();
if (!cleanCode) {
  erreur = "Aucun code QR n'a été détecté dans ce lien.";
} else {
  try {
    // Le serveur du client appelle l'API pour le compte du visiteur : sans l'adresse de celui-ci, toutes les
    // validations compteraient pour l'IP de ce serveur dans la limitation de débit de l'API. L'API ne la prend en
    // compte que si le secret partagé SSR_FORWARD_SECRET est exact (voir app/core/rate_limit.py côté API).
    const entetesApi: Record<string, string> = {};
    const secretSsr = process.env.SSR_FORWARD_SECRET;
    const ip = ipVisiteur(
      Astro.request.headers.get('x-forwarded-for'),
      Astro.clientAddress,
      Number(process.env.TRUSTED_PROXY_HOPS || 0),
    );
    if (secretSsr && ip) {
      entetesApi['X-Ikan-Ssr-Secret'] = secretSsr;
      entetesApi['X-Ikan-Client-Ip'] = ip;
    }
    const res = await fetch(`${SSR_API_URL}/qr-codes/${encodeURIComponent(cleanCode)}/validate`, {
      signal: AbortSignal.timeout(2000),
      headers: entetesApi,
    });
    if (res.ok) {
      agenceInfo = await res.json();
    } else if (res.status === 404) {
      // Inconnu, désactivé, ou agence désactivée : l'API répond 404 dans tous les cas (rien n'est révélé).
      erreur = "Ce QR code n'est pas reconnu ou n'est plus actif.";
    }
  } catch (e) {
    // Service lent ou injoignable : le navigateur revalide (états « chargement » / « indisponible »).
  }
}
if (erreur) Astro.response.status = 404;
---

<FeedbackLayout
  title={agenceInfo?.agence_nom ? `Votre avis — ${agenceInfo.agence_nom}` : 'IKAN AI — Votre avis en agence'}
  agenceNom={agenceInfo?.agence_nom}
>
  <div class="page-outer" data-api-url={SSR_API_URL} data-qr-valide={agenceInfo ? '1' : '0'} data-retention-mois={agenceInfo?.retention_mois ?? ''}>
    <div class="card-shell">
      {erreur ? (
        <div class="error-screen">
          <div class="error-icon">⚠️</div>
          <h2>QR Code non reconnu</h2>
          <p>{erreur}</p>
          <p>Merci de prévenir l'agence afin qu'elle vous indique le bon QR code. Vous pouvez aussi scanner de nouveau le QR code affiché en agence.</p>
        </div>
      ) : (
        <>
          <!-- ================= HERO HEADER (Vert IKAN AI) ================= -->
          <header class="hero">
            <div class="hero-pattern" aria-hidden="true"></div>

            <div class="hero-top">
              <div class="hero-logo-box">
                <img
                  src="/ikanai-logo-horizontal.png"
                  alt="IKAN AI"
                  class="hero-brand-logo"
                  loading="eager"
                  decoding="sync"
                />
              </div>
              <div class="agency-chip" id="agencyBadgeContainer">
                <span class="agency-live-dot" aria-hidden="true"></span>
                <span id="agencyBadgeText">{agenceInfo?.agence_nom || 'AGENCE EN DIRECT'}</span>
              </div>
            </div>

            <div class="hero-copy">
              <h1 class="hero-title">Votre avis compte pour nous.</h1>
            </div>
          </header>

          <!-- ================= FORMULAIRE PRINCIPAL ================= -->
          <main class="form-flow">

            <!-- États de la page : vérification du QR code, QR invalide ou service indisponible -->
            <section id="screen-chargement" class="screen-view state-view" style="display:none;" role="status" aria-live="polite">
              <div class="state-spinner" aria-hidden="true"></div>
              <p class="state-text">Vérification du QR code…</p>
            </section>
            <section id="screen-erreur" class="screen-view state-view" style="display:none;" role="alert">
              <div class="error-icon" aria-hidden="true">⚠️</div>
              <h2 id="erreurTitre" class="state-title"></h2>
              <p id="erreurMessage" class="state-text"></p>
              <button type="button" class="btn-secondary" id="btnReessayerQr" hidden>Réessayer</button>
            </section>

            <!-- ÉCRAN D'ACCUEIL : nom de l'agence et deux choix -->
            <section id="screen-accueil" class="screen-view accueil-view">
              <p class="accueil-agence" id="accueilAgenceNom">{agenceInfo?.agence_nom || 'Votre agence'}</p>
              <h2 class="accueil-titre">Que souhaitez-vous faire ?</h2>
              <button type="button" class="choix-carte" id="btnChoixNote">
                <svg class="choix-icone" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                <span class="choix-texte">
                  <span class="choix-titre">Noter l'expérience</span>
                  <span class="choix-sous">Dites-nous comment s'est passée votre visite</span>
                </span>
              </button>
              <button type="button" class="choix-carte" id="btnChoixIdee">
                <svg class="choix-icone" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 18h6"/><path d="M10 22h4"/>
                  <path d="M12 2a7 7 0 0 0-4 12.75c.64.46 1 1.2 1 2V17h6v-.25c0-.8.36-1.54 1-2A7 7 0 0 0 12 2z"/>
                </svg>
                <span class="choix-texte">
                  <span class="choix-titre">Partager une idée</span>
                  <span class="choix-sous">Une suggestion pour améliorer l'agence</span>
                </span>
              </button>
            </section>

            <!-- ÉCRAN IDÉE : un seul champ texte, aucun contact -->
            <section id="screen-idee" class="screen-view idee-view" style="display:none;">
              <button type="button" class="lien-retour" id="btnRetourIdee">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                <span>Retour</span>
              </button>
              <div class="form-section">
                <label class="field-label" for="inputIdee">Quelle est votre idée pour améliorer l'agence&nbsp;?</label>
                <div class="textarea-box">
                  <textarea
                    id="inputIdee"
                    class="styled-textarea"
                    rows="5"
                    maxlength="1000"
                    aria-describedby="ideeCharCount ideeError"
                    placeholder="Décrivez votre idée en quelques mots..."
                  ></textarea>
                  <div class="textarea-footer">
                    <span class="char-count" id="ideeCharCount">1000 caractères restants sur 1000</span>
                  </div>
                </div>
                <p class="field-error" id="ideeError" role="alert" hidden></p>
              </div>

              <!-- CHAMP PIÈGE (voir plus bas) -->
              <div class="champ-piege" aria-hidden="true">
                <label for="champIdeeSiteWeb">Ne pas remplir ce champ</label>
                <input type="text" id="champIdeeSiteWeb" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <div class="submit-wrap">
                <button type="button" id="btnSubmitIdee" class="btn-submit">
                  <span class="btn-text">Envoyer mon idée</span>
                  <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </button>
              </div>
            </section>

            <!-- CONFIRMATION D'UNE IDÉE -->
            <section id="screen-idee-merci" class="screen-view success-view" style="display:none;" role="status">
              <div class="success-card">
                <div class="success-animation-wrap">
                  <div class="success-icon-badge">
                    <svg viewBox="0 0 64 64" width="64" height="64" fill="none" aria-hidden="true">
                      <circle cx="32" cy="32" r="30" fill="#EBF7EE" stroke="#3C7730" stroke-width="2"/>
                      <circle cx="32" cy="32" r="23" fill="#3C7730"/>
                      <path d="M22 32.5 L28.5 39 L42 25.5" stroke="#FFFFFF" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
                <h2 class="success-title">Merci pour votre idée !</h2>
                <p class="success-message">Votre idée a bien été transmise à l'agence. Toute l'équipe vous remercie de contribuer à l'améliorer.</p>
                <div class="success-actions">
                  <button type="button" class="btn-secondary" id="btnIdeeAccueil">
                    <span>Retour à l'accueil</span>
                  </button>
                </div>
              </div>
            </section>

            <!-- ÉCRAN 1 : FORMULAIRE -->
            <section id="screen-sentiment" class="screen-view" style="display:none;">

              <!-- SECTION 0 : CATÉGORIE DE L'AVIS (obligatoire, définie par l'agence) -->
              <div class="form-section categorie-section">
                <div class="section-head">
                  <label class="field-label" for="categorieSelect">Quelle catégorie concerne votre avis ?</label>
                </div>
                <select id="categorieSelect" class="styled-select" disabled aria-describedby="categorieError">
                  <option value="" disabled selected>Chargement des catégories...</option>
                </select>
                <p class="field-error" id="categorieError" role="alert" hidden></p>
                <button type="button" class="btn-secondary" id="btnRecharger" hidden>Réessayer</button>
              </div>

              <!-- SECTION 1 : ÉVALUATION (5 EMOJIS) -->
              <div class="form-section sentiment-section">
                <p class="field-label" id="ratingLabel">Comment s'est passée votre visite ?</p>
                <div class="sentiment-grid" id="sentimentsGrid" role="radiogroup" aria-labelledby="ratingLabel" aria-describedby="ratingHint ratingError">
                  <!-- 1. Mauvais -->
                  <button type="button" class="sentiment-tile tone-mauvais" data-sentiment="mauvais" role="radio" aria-checked="false" aria-label="Mauvais" tabindex="0">
                    <div class="sentiment-icon">
                      <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
                        <circle cx="20" cy="20" r="18" fill="#EF4444"/>
                        <circle cx="14" cy="16" r="2.3" fill="#FFFFFF"/>
                        <circle cx="26" cy="16" r="2.3" fill="#FFFFFF"/>
                        <path d="M13 28 C15.5 23, 24.5 23, 27 28" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round"/>
                        <path d="M11 12.5 L16 14.5" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M29 12.5 L24 14.5" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round"/>
                      </svg>
                    </div>
                    <span class="tile-label">Mauvais</span>
                  </button>

                  <!-- 2. Passable -->
                  <button type="button" class="sentiment-tile tone-passable" data-sentiment="passable" role="radio" aria-checked="false" aria-label="Passable" tabindex="-1">
                    <div class="sentiment-icon">
                      <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
                        <circle cx="20" cy="20" r="18" fill="#F97316"/>
                        <circle cx="14" cy="16" r="2.3" fill="#FFFFFF"/>
                        <circle cx="26" cy="16" r="2.3" fill="#FFFFFF"/>
                        <path d="M14 27 C16.5 23.5, 23.5 23.5, 26 27" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round"/>
                      </svg>
                    </div>
                    <span class="tile-label">Passable</span>
                  </button>

                  <!-- 3. Neutre -->
                  <button type="button" class="sentiment-tile tone-neutre" data-sentiment="neutre" role="radio" aria-checked="false" aria-label="Neutre" tabindex="-1">
                    <div class="sentiment-icon">
                      <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
                        <circle cx="20" cy="20" r="18" fill="#FACC15"/>
                        <circle cx="14" cy="16" r="2.3" fill="#1F2937"/>
                        <circle cx="26" cy="16" r="2.3" fill="#1F2937"/>
                        <line x1="14" y1="26" x2="26" y2="26" stroke="#1F2937" stroke-width="2.8" stroke-linecap="round"/>
                      </svg>
                    </div>
                    <span class="tile-label">Neutre</span>
                  </button>

                  <!-- 4. Bien -->
                  <button type="button" class="sentiment-tile tone-bien" data-sentiment="bien" role="radio" aria-checked="false" aria-label="Bien" tabindex="-1">
                    <div class="sentiment-icon">
                      <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
                        <circle cx="20" cy="20" r="18" fill="#4CAF50"/>
                        <circle cx="14" cy="16" r="2.3" fill="#FFFFFF"/>
                        <circle cx="26" cy="16" r="2.3" fill="#FFFFFF"/>
                        <path d="M13 23 C16 28.5, 24 28.5, 27 23" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round"/>
                      </svg>
                    </div>
                    <span class="tile-label">Bien</span>
                  </button>

                  <!-- 5. Excellent (avec étoile dorée) -->
                  <button type="button" class="sentiment-tile tone-excellente" data-sentiment="excellente" role="radio" aria-checked="false" aria-label="Excellent" tabindex="-1">
                    <div class="sentiment-icon">
                      <svg viewBox="0 0 40 40" width="38" height="38" fill="none">
                        <circle cx="20" cy="20" r="18" fill="#147A43"/>
                        <circle cx="13.5" cy="16" r="2.3" fill="#FFFFFF"/>
                        <circle cx="26.5" cy="16" r="2.3" fill="#FFFFFF"/>
                        <path d="M12 22.5 C15 29.5, 25 29.5, 28 22.5" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round"/>
                        <!-- Étoile scintillante dorée -->
                        <path d="M 32 6 L 33.3 9.8 L 37 10.1 L 34.2 12.5 L 35 16.2 L 32 14.2 L 29 16.2 L 29.8 12.5 L 27 10.1 L 30.7 9.8 Z" fill="#FACC15" stroke="#CA8A04" stroke-width="0.6"/>
                      </svg>
                    </div>
                    <span class="tile-label">Excellent</span>
                  </button>
                </div>
                <p class="sr-only" id="ratingHint">Utilisez les flèches pour parcourir les cinq niveaux, Espace ou Entrée pour choisir.</p>
                <p class="field-error" id="ratingError" role="alert" hidden></p>

              </div>

              <!-- SECTION 3 : COMMENTAIRE & DICTÉE VOCALE -->
              <div class="form-section comment-section">
                <label class="field-label" for="inputCommentaire">Un commentaire ? <span class="optional">(facultatif)</span></label>
                <div class="textarea-box">
                  <textarea
                    id="inputCommentaire"
                    class="styled-textarea"
                    rows="3"
                    maxlength="1000"
                    aria-describedby="charCount"
                    placeholder="Partagez votre ressenti ou une remarque..."
                  ></textarea>

                  <div class="textarea-footer">
                    <button type="button" class="mic-btn" id="micBtnCommentaire" aria-label="Dicter à la voix" title="Dicter votre commentaire à la voix">
                      <svg class="mic-icon-on" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                        <line x1="12" y1="19" x2="12" y2="23"/>
                        <line x1="8" y1="23" x2="16" y2="23"/>
                      </svg>
                      <svg class="mic-icon-off" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                        <line x1="1" y1="1" x2="23" y2="23"/>
                        <path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V4a3 3 0 0 0-5.94-.6"/>
                        <path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"/>
                        <line x1="12" y1="19" x2="12" y2="23"/>
                        <line x1="8" y1="23" x2="16" y2="23"/>
                      </svg>
                      <span class="mic-text">Parler</span>
                    </button>

                    <span class="char-count" id="charCount">1000 caractères restants sur 1000</span>
                  </div>
                </div>

                <div class="voice-status-bar" id="voiceStatusCommentaire" style="display:none;"></div>
              </div>

              <!-- CHAMP PIÈGE : invisible et hors parcours clavier. Une personne ne le remplit jamais ; un robot oui. -->
              <div class="champ-piege" aria-hidden="true">
                <label for="champSiteWeb">Ne pas remplir ce champ</label>
                <input type="text" id="champSiteWeb" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <!-- SECTION 4 : RECONTACT (proposé seulement si la durée de conservation est connue : voir demarrer()) -->
              <div class="form-section recontact-section" id="recontactSection">
                <div class="recontact-row">
                  <div class="section-head">
                    <label class="field-label-inline">
                      Souhaitez-vous être recontacté ?
                    </label>
                  </div>

                  <div class="segmented-control" role="group" aria-label="Être recontacté">
                    <button type="button" class="segment is-active" id="recontactNo" data-value="non">Non</button>
                    <button type="button" class="segment" id="recontactYes" data-value="oui">Oui</button>
                  </div>
                </div>

                <div class="reveal-panel" id="contactFieldsPanel" hidden>
                  <div class="contact-inputs-grid">
                    <div class="input-with-icon">
                      <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                      </svg>
                      <input
                        type="tel"
                        inputmode="tel"
                        autocomplete="tel"
                        id="contactTelInput"
                        aria-label="Numéro de téléphone pour être recontacté"
                        placeholder="+ indicatif et numéro"
                        class="styled-input"
                        aria-describedby="contactTelError"
                      />
                    </div>
                  </div>
                  <p class="field-error" id="contactTelError" role="alert" hidden></p>
                  <label class="consent-row" for="consentCheckbox">
                    <input type="checkbox" id="consentCheckbox" class="consent-box" aria-describedby="consentError" />
                    <span class="consent-case" aria-hidden="true"></span>
                    <span id="consentText"></span>
                  </label>
                  <p class="field-error" id="consentError" role="alert" hidden></p>
                </div>
              </div>

              <!-- BOUTON D'ENVOI PRINCIPAL -->
              <div class="submit-wrap">
                <p class="field-error submit-error" id="submitError" role="alert" hidden></p>
                <button type="button" id="btnSubmitFeedback" class="btn-submit">
                  <span class="btn-text">Envoyer mon avis</span>
                  <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </button>
              </div>

              <!-- NOTE DE CONFIDENTIALITÉ -->
              <p class="lock-note">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>Votre avis est confidentiel.</span>
              </p>
            </section>

            <!-- ÉCRAN 2 : SUCCÈS CONFIRMATION -->
            <section id="screen-success" class="screen-view success-view" style="display:none;">
              <div class="success-card">
                <div class="success-animation-wrap">
                  <div class="success-pulse-ring"></div>
                  <div class="success-icon-badge">
                    <svg viewBox="0 0 64 64" width="64" height="64" fill="none">
                      <circle cx="32" cy="32" r="30" fill="#EBF7EE" stroke="#3C7730" stroke-width="2"/>
                      <circle cx="32" cy="32" r="23" fill="#3C7730"/>
                      <path d="M22 32.5 L28.5 39 L42 25.5" stroke="#FFFFFF" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>

                <h2 class="success-title">Merci pour votre retour !</h2>
                <p class="success-message">
                  Votre avis a bien été enregistré. Il aide nos équipes à élever la qualité de service au quotidien.
                </p>

                <div class="success-status-pill">
                  <span class="live-dot-green"></span>
                  <span>Transmis en direct à l'agence</span>
                </div>

                <!-- Question NPS facultative, révélée en JS après succès de l'envoi
                     principal (uniquement si un nps_token a été reçu, voir le script) -->
                <div class="nps-block" id="npsBlock" style="display:none;">
                  <p class="nps-question" id="npsQuestionText">
                    Une dernière question, facultative : sur une échelle de 0 à 10,
                    recommanderiez-vous <strong id="npsAgenceNom">cette agence</strong> à un proche ?
                  </p>
                  <div class="nps-scale" id="npsScale" role="group" aria-label="Note de recommandation, de 0 à 10"></div>
                  <div class="nps-scale-labels" aria-hidden="true">
                    <span>Pas du tout probable</span>
                    <span>Très probable</span>
                  </div>
                  <button type="button" class="nps-skip-link" id="btnNpsSkip">Passer</button>
                  <p class="nps-thanks" id="npsThanks" style="display:none;" role="status">Merci pour votre réponse !</p>
                </div>

                <div class="success-actions">
                  <button type="button" class="btn-secondary" id="btnNewFeedback">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                      <path d="M21 3v5h-5"/>
                      <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                      <path d="M8 16H3v5"/>
                    </svg>
                    <span>Donner un autre avis</span>
                  </button>
                </div>
              </div>
            </section>

          </main>
        </>
      )}
    </div>
  </div>
</FeedbackLayout>

<style>
  /* =========================================================
     PAGE CONTENEUR & AMBIANCE BLANCHE LUMINEUSE
     ========================================================= */
  .page-outer {
    position: relative;
    width: min(100%, 1000px);
    margin: 0 auto;
    border-radius: 48px;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 18% 0%, rgba(255, 255, 255, 0.98) 0%, transparent 42%),
      radial-gradient(ellipse at 86% 100%, rgba(60, 119, 48, 0.12) 0%, transparent 40%),
      linear-gradient(135deg, #FFFFFF 0%, #FBFDFC 48%, #EEF5F0 100%);
    padding: clamp(12px, 3vh, 36px) clamp(10px, 2.5vw, 24px);
    box-sizing: border-box;
  }

  .page-outer::before {
    content: '';
    position: absolute;
    inset: 5px;
    z-index: -1;
    border: 1px solid rgba(60, 119, 48, 0.1);
    border-radius: 48px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(226, 238, 229, 0.24)),
      linear-gradient(115deg, transparent 0 48%, rgba(60, 119, 48, 0.035) 48.2% 48.5%, transparent 48.7%);
    box-shadow:
      0 34px 90px rgba(2, 48, 45, 0.1),
      0 10px 26px rgba(60, 119, 48, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.96),
      inset 0 -1px 0 rgba(60, 119, 48, 0.04);
    transform: perspective(1100px) rotateX(1.2deg) translateZ(0);
    pointer-events: none;
  }

  .page-outer::after {
    content: '';
    position: absolute;
    left: -8%;
    right: -8%;
    bottom: -18%;
    height: 52%;
    z-index: -1;
    opacity: 0.42;
    background:
      linear-gradient(rgba(60, 119, 48, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(60, 119, 48, 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    transform: perspective(700px) rotateX(58deg) rotateZ(-3deg) scale(1.16);
    transform-origin: center bottom;
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent 82%);
    pointer-events: none;
  }

  .card-shell {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 650px;
    background: #FFFFFF;
    border-radius: 26px;
    box-shadow:
      0 20px 45px -10px rgba(2, 48, 45, 0.09),
      0 1px 3px rgba(2, 48, 45, 0.04),
      0 0 0 1px rgba(2, 48, 45, 0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.3s ease;
  }

  .card-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 5;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  /* =========================================================
     HERO HEADER (VERT SIGNATURE IKAN AI)
     ========================================================= */
  .hero {
