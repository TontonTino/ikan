  /* Zones tactiles : 44 x 44 px au minimum sur TOUS les contrôles (largeur ET hauteur), test : src/utils/accessibilite.test.mjs */
  .sentiment-tile,
  .segment,
  .mic-btn,
  .btn-secondary,
  .btn-submit,
  .nps-skip-link {
