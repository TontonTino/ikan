  .sector-badge-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #02302D;
