</style>

<script>
  // Navigation & Logic
  const DEFAULT_API_URL = 'https://ikanai-api.onrender.com/api/v1';
  const pageOuter = document.querySelector('.page-outer') as HTMLElement | null;
  let API_URL = pageOuter?.dataset.apiUrl || DEFAULT_API_URL;

  // Requête API résiliente avec bascule automatique vers Render en cas d'échec local
  async function fetchAPI(endpoint: string, options: RequestInit = {}) {
    try {
      const res = await fetch(`${API_URL}${endpoint}`, options);
      return res;
    } catch (err) {
      if (API_URL !== DEFAULT_API_URL) {
        console.warn(`Serveur local injoignable, bascule automatique vers l'API Render (${DEFAULT_API_URL})`);
        API_URL = DEFAULT_API_URL;
        return await fetch(`${DEFAULT_API_URL}${endpoint}`, options);
      }
      throw err;
    }
  }

  const pathParts = window.location.pathname.split('/').filter(Boolean);
  const urlParams = new URLSearchParams(window.location.search);
  let QR_CODE = urlParams.get('qr') || urlParams.get('code') || '';

  if (!QR_CODE && pathParts.length >= 2 && pathParts[0] === 'feedback') {
    QR_CODE = decodeURIComponent(pathParts[1]);
  } else if (!QR_CODE && pathParts.length === 1 && pathParts[0] !== 'feedback') {
    QR_CODE = decodeURIComponent(pathParts[0]);
  }

  if (!QR_CODE) {
    QR_CODE = 'QR-ORANGE-BURKINA-01';
  }

  async function refreshAgency() {
    try {
      const res = await fetchAPI(`/qr-codes/${encodeURIComponent(QR_CODE)}/validate`);
      if (res.ok) {
        const data = await res.json();
        const badgeEl = document.getElementById('agencyBadgeText');
        if (badgeEl && data.agence_nom) {
          badgeEl.textContent = data.agence_nom;
        }
        if (data.agence_nom) {
          document.title = `Avis — ${data.agence_nom}`;
        }
      }
    } catch (e) {
      console.warn("Info agence:", e);
    }
  }
  refreshAgency();

  let sentimentSelectionne: 'negatif' | 'neutre' | 'positif' | null = null;

  const screens = {
    sentiment: document.getElementById('screen-sentiment')!,
    success: document.getElementById('screen-success')!,
  };

  function switchScreen(target: 'sentiment' | 'success') {
    Object.keys(screens).forEach(key => {
      const el = screens[key as keyof typeof screens];
      if (el) el.style.display = key === target ? 'flex' : 'none';
    });
  }

  const sentimentPlaceholders: Record<string, string> = {
    negatif: "Qu'est-ce qui n'a pas été à la hauteur lors de votre visite ?",
    neutre: "Que pourrions-nous améliorer lors de vos prochains passages ?",
    positif: "Qu'avez-vous particulièrement apprécié lors de votre passage ?",
  };
  const defaultPlaceholder = "Partagez votre ressenti, une remarque ou une suggestion...";

  // Sélection des 3 Sentiments
  const sentimentBtns = document.querySelectorAll<HTMLButtonElement>('.sentiment-tile');
  sentimentBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const textarea = document.getElementById('inputCommentaire') as HTMLTextAreaElement | null;
      if (btn.classList.contains('selected')) {
        btn.classList.remove('selected');
        sentimentSelectionne = null;
        if (textarea && !textarea.value.trim()) {
          textarea.placeholder = defaultPlaceholder;
        }
        return;
      }
      sentimentBtns.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      sentimentSelectionne = (btn.dataset.sentiment as 'negatif' | 'neutre' | 'positif') || null;
      if (textarea && !textarea.value.trim() && sentimentSelectionne) {
        textarea.placeholder = sentimentPlaceholders[sentimentSelectionne] || defaultPlaceholder;
      }
    });
  });

  // Contrôle segmenté générique (Oui/Non)
  function setupSegmented(yesId: string, noId: string, panelId: string) {
    const yesBtn = document.getElementById(yesId) as HTMLButtonElement | null;
    const noBtn = document.getElementById(noId) as HTMLButtonElement | null;
    const panel = document.getElementById(panelId) as HTMLElement | null;
    if (!yesBtn || !noBtn || !panel) return { isYes: () => false };

    let isYes = false;

    function setState(yes: boolean) {
      isYes = yes;
      yesBtn!.classList.toggle('is-active', yes);
      noBtn!.classList.toggle('is-active', !yes);
      panel!.hidden = !yes;
    }

    yesBtn.addEventListener('click', () => setState(true));
    noBtn.addEventListener('click', () => setState(false));

    return { isYes: () => isYes };
  }

  const recontactControl = setupSegmented('recontactYes', 'recontactNo', 'contactFieldsSentiment');

  // ================= DICTÉE VOCALE ROBUSTE (Web Speech API) =================
  const MAX_COMMENT_LENGTH = 500;

  type VoiceFieldConfig = {
    textarea: HTMLTextAreaElement;
    micBtn: HTMLButtonElement;
    statusEl: HTMLParagraphElement;
  };

  function setupVoiceField(config: VoiceFieldConfig) {
    const { textarea, micBtn, statusEl } = config;

    const SpeechRecognitionCtor =
      (window as any).SpeechRecognition ||
      (window as any).webkitSpeechRecognition ||
      (window as any).mozSpeechRecognition ||
      (window as any).msSpeechRecognition;

    const isSecure =
      window.isSecureContext ||
      window.location.hostname === 'localhost' ||
      window.location.hostname === '127.0.0.1';

    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

    let recognitionInstance: any = null;
    let isRecording = false;
    let baseComment = '';
    let manualStop = false;

    const iconOn = micBtn.querySelector('.mic-icon-on') as SVGElement | null;
    const iconOff = micBtn.querySelector('.mic-icon-off') as SVGElement | null;

    function setRecordingUI(recording: boolean) {
      isRecording = recording;
      micBtn.classList.toggle('recording', recording);
      micBtn.setAttribute('aria-pressed', recording ? 'true' : 'false');

      if (iconOn && iconOff) {
        iconOn.style.display = recording ? 'none' : 'block';
        iconOff.style.display = recording ? 'block' : 'none';
      }

      if (recording) {
        statusEl.className = 'voice-status';
        statusEl.innerHTML =
          '<span class="voice-wave"><span></span><span></span><span></span></span> <span>Écoute en cours... Parlez maintenant</span>';
        statusEl.style.display = 'flex';
      } else {
        if (!statusEl.classList.contains('is-error')) {
          statusEl.style.display = 'none';
        }
      }
    }

    function showError(message: string) {
      statusEl.className = 'voice-status is-error';
      statusEl.innerHTML = `⚠️ <span>${message}</span>`;
      statusEl.style.display = 'flex';
    }

    function showEmbeddedBrowserHint() {
      textarea.focus();
      statusEl.className = 'voice-status is-error';
      statusEl.innerHTML = '';
      statusEl.append('🎙️ ');

      const message = document.createElement('span');
      message.textContent = 'Utilisez le micro de votre clavier pour dicter';
      statusEl.appendChild(message);

      const openLink = document.createElement('a');
      openLink.className = 'voice-open-browser';
      openLink.href = window.location.href;
      openLink.target = '_blank';
      openLink.rel = 'noopener noreferrer';
      openLink.textContent = 'ou ouvrir dans Safari';
      statusEl.appendChild(openLink);
      statusEl.style.display = 'flex';
    }

    function stopRecognition() {
      manualStop = true;
      if (recognitionInstance) {
        try {
          recognitionInstance.stop();
        } catch {
          try {
            recognitionInstance.abort();
          } catch {
            // Ignorer
          }
        }
        recognitionInstance = null;
      }
      setRecordingUI(false);
    }

    function startRecognition() {
      // 1. Détection navigateur intégré (ex: WhatsApp, Instagram) où Apple désactive le SpeechRecognition
      if (!SpeechRecognitionCtor) {
        showEmbeddedBrowserHint();
        return;
      }

      manualStop = false;
      baseComment = textarea.value.trim();

      try {
        const recognition = new SpeechRecognitionCtor();
        recognitionInstance = recognition;

        // Safari iOS ne supporte pas continuous=true (provoque une erreur immédiate)
        recognition.continuous = !isMobile;
        recognition.interimResults = true;
        recognition.lang = 'fr-FR';
        recognition.maxAlternatives = 1;

        recognition.onstart = () => {
          setRecordingUI(true);
        };

        recognition.onresult = (event: any) => {
          let finalTranscript = '';
          let interimTranscript = '';

          for (let i = event.resultIndex; i < event.results.length; i++) {
            const result = event.results[i];
            const text = result[0]?.transcript || '';
            if (result.isFinal) {
              finalTranscript += text;
            } else {
              interimTranscript += text;
            }
          }

          const prefix = baseComment ? `${baseComment} ` : '';
          const currentTranscript = finalTranscript || interimTranscript;

          if (currentTranscript) {
            const newContent = `${prefix}${currentTranscript}`.slice(0, MAX_COMMENT_LENGTH);
            textarea.value = newContent;

            // Déclencher l'événement input pour mettre à jour en direct le compteur 0 / 500
            textarea.dispatchEvent(new Event('input', { bubbles: true }));

            if (finalTranscript) {
              baseComment = newContent;
            }
          }
        };

        recognition.onerror = (event: any) => {
          console.warn('SpeechRecognition error:', event.error);
          setRecordingUI(false);

          if (event.error === 'not-allowed' || event.error === 'permission-denied') {
            textarea.focus();
            if (!isSecure) {
              showError("Micro web bloqué en HTTP local par la sécurité de votre téléphone. En HTTPS sur Render, le micro s'active directement. Vous pouvez dicter avec la touche micro 🎙️ du clavier.");
            } else {
              showError("Microphone refusé. Autorisez l'accès au micro dans les paramètres du navigateur.");
            }
          } else if (event.error === 'no-speech') {
            showError("Aucune parole détectée. Réessayez en parlant distinctement.");
          } else if (event.error === 'network') {
            showError("Erreur réseau de reconnaissance vocale.");
          } else if (event.error === 'service-not-allowed') {
            showEmbeddedBrowserHint();
          } else {
            showError("Écoute interrompue. Réessayez.");
          }
        };

        recognition.onend = () => {
          recognitionInstance = null;
          setRecordingUI(false);
        };

        recognition.start();
      } catch (err) {
        console.error('Erreur démarrage reconnaissance:', err);
        setRecordingUI(false);
        textarea.focus();
        if (!isSecure) {
          showError("Micro web bloqué en HTTP local. En HTTPS sur Render, le micro s'active directement.");
        } else {
          showError("Impossible d'activer le micro sur ce navigateur.");
        }
      }
    }

    micBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (isRecording) {
        stopRecognition();
      } else {
        startRecognition();
      }
    });
  }

  function wireVoiceField(textareaId: string, micId: string, statusId: string) {
    const textarea = document.getElementById(textareaId) as HTMLTextAreaElement | null;
    const micBtn = document.getElementById(micId) as HTMLButtonElement | null;
    const statusEl = document.getElementById(statusId) as HTMLParagraphElement | null;
    if (textarea && micBtn && statusEl) {
      setupVoiceField({ textarea, micBtn, statusEl });
    }
  }

  wireVoiceField('inputCommentaire', 'micBtnCommentaire', 'voiceStatusCommentaire');

  // Compteur de caractères dynamique en direct
  const commentTextarea = document.getElementById('inputCommentaire') as HTMLTextAreaElement | null;
  const charCountEl = document.getElementById('charCount');
  const updateCharCount = () => {
    if (commentTextarea && charCountEl) {
      charCountEl.textContent = `${commentTextarea.value.length} / 500`;
    }
  };
  if (commentTextarea && charCountEl) {
    commentTextarea.addEventListener('input', updateCharCount);
    updateCharCount();
  }

  // Envoi du Formulaire
  document.getElementById('btnSubmitSentiment')?.addEventListener('click', async () => {
    const commentaireTexte = (document.getElementById('inputCommentaire') as HTMLTextAreaElement).value.trim();

    const isRecontact = recontactControl.isYes();

    if (!sentimentSelectionne && !commentaireTexte) {
      alert("Veuillez sélectionner un ressenti ou écrire un commentaire.");
      return;
    }

    const contactTel = (document.getElementById('contactTelSentiment') as HTMLInputElement)?.value.trim() || null;
    const contactEmail = (document.getElementById('contactEmailSentiment') as HTMLInputElement)?.value.trim() || null;

    if (isRecontact && !contactTel && !contactEmail) {
      alert("Veuillez renseigner votre numéro de téléphone ou votre adresse e-mail afin que nous puissions vous recontacter.");
      return;
    }

    const btn = document.getElementById('btnSubmitSentiment') as HTMLButtonElement;
    btn.disabled = true;
    btn.innerHTML = '<span class="btn-spinner"></span> <span class="btn-text">Envoi de votre avis...</span>';

    const noteValeur = sentimentSelectionne === 'negatif' ? 1 : sentimentSelectionne === 'positif' ? 5 : 3;

    const payload: any = {
      sentiment: sentimentSelectionne || 'neutre',
      note: noteValeur,
      commentaire: commentaireTexte || null,
      suggestion: null,
      souhaite_etre_rappele: isRecontact,
      contact_nom: null,
      contact_telephone: isRecontact ? contactTel : null,
      contact_email: isRecontact ? contactEmail : null,
    };

    try {
      const res = await fetchAPI(`/feedbacks/?qr_code=${encodeURIComponent(QR_CODE)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        switchScreen('success');
      } else {
        const errData = await res.json().catch(() => ({}));
        alert(`Erreur lors de l'envoi : ${errData.detail || 'Code QR invalide'}`);
        btn.disabled = false;
        btn.innerHTML = '<span class="btn-text">Envoyer mon avis</span><span class="arrow">›</span>';
      }
    } catch (e) {
      console.error("Erreur d'envoi feedback:", e);
      alert("Erreur de connexion avec le serveur API. Veuillez réessayer.");
      btn.disabled = false;
      btn.innerHTML = '<span class="btn-text">Envoyer mon avis</span><span class="arrow">›</span>';
    }
  });

  // Réinitialiser pour un nouvel avis
  document.getElementById('btnNewFeedback')?.addEventListener('click', () => {
    sentimentBtns.forEach(b => b.classList.remove('selected'));
    sentimentSelectionne = null;
    if (commentTextarea) {
      commentTextarea.value = '';
      commentTextarea.placeholder = defaultPlaceholder;
      updateCharCount();
    }
    const noBtn = document.getElementById('recontactNo');
    noBtn?.click();
    const contactTel = document.getElementById('contactTelSentiment') as HTMLInputElement;
    const contactEmail = document.getElementById('contactEmailSentiment') as HTMLInputElement;
    if (contactTel) contactTel.value = '';
    if (contactEmail) contactEmail.value = '';
    const btn = document.getElementById('btnSubmitSentiment') as HTMLButtonElement;
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<span class="btn-text">Envoyer mon avis</span><span class="arrow">›</span>';
    }
    switchScreen('sentiment');
  });
</script>