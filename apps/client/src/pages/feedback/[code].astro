  .sector-choice-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 6px 10px;
    border: none;
    border-radius: 8px;
    background: transparent;
    font-size: 0.76rem;
    font-weight: 500;
    color: #02302D;
    text-align: left;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sector-choice-btn:hover {
    background: #F1F5F9;
    color: #3C7730;
  }

  .sector-choice-btn.is-active {
    background: #EBF7EE;
