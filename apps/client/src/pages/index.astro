---
import FeedbackLayout from '../layouts/FeedbackLayout.astro';
import IkanLogo from '../components/IkanLogo.astro';
---
<FeedbackLayout title="IKAN AI — Espace Avis Client">
  <div class="redirect-wrapper">
    <div class="redirect-card">
      <div class="logo-box">
        <IkanLogo variant="dark" size={56} />
      </div>
      <div class="spinner-ring"></div>
      <h1 class="redirect-title">Chargement de votre espace avis...</h1>
      <p class="redirect-sub">Connexion sécurisée à votre agence en cours</p>
    </div>
  </div>

  <style>
    .redirect-wrapper {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }
    .redirect-card {
      width: 100%;
      max-width: 420px;
      background: var(--color-surface);
      border-radius: 24px;
      padding: 40px 24px;
      text-align: center;
      box-shadow: var(--shadow-card);
      border: 1px solid var(--color-trait);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .logo-box {
      margin-bottom: 24px;
    }
    .spinner-ring {
      width: 38px;
      height: 38px;
      border: 3px solid var(--color-trait);
      border-top-color: var(--color-accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-bottom: 20px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    .redirect-title {
      font-size: var(--text-lg);
      font-weight: var(--weight-semibold);
      color: var(--color-encre);
      margin-bottom: 6px;
    }
    .redirect-sub {
      font-size: var(--text-sm);
      color: var(--color-text-2);
      margin: 0;
    }
  </style>

  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const qrParam = urlParams.get('qr') || urlParams.get('code');
    if (qrParam && qrParam.trim()) {
      window.location.href = `/feedback/${encodeURIComponent(qrParam.trim())}`;
    } else {
      // Aucune agence par défaut : sans code QR, on n'ouvre aucun formulaire.
      const titre = document.querySelector('.redirect-title');
      const sous = document.querySelector('.redirect-sub');
      document.querySelector('.spinner-ring')?.remove();
      if (titre) titre.textContent = 'QR Code non détecté';
      if (sous) sous.textContent = "Scannez le QR code affiché en agence pour donner votre avis.";
    }
  </script>
</FeedbackLayout>
