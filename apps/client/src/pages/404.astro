---
import FeedbackLayout from '../layouts/FeedbackLayout.astro';
import IkanLogo from '../components/IkanLogo.astro';
---

<FeedbackLayout title="IKAN AI — Redirection">
  <div class="redirect-wrapper">
    <div class="redirect-card">
      <div class="logo-box">
        <IkanLogo variant="dark" size={56} />
      </div>
      <div class="spinner-ring"></div>
      <h1 class="redirect-title">Redirection en cours...</h1>
      <p class="redirect-sub">Ouverture de votre formulaire de satisfaction</p>
    </div>
  </div>

  <style>
    .redirect-wrapper {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }
    .redirect-card {
      width: 100%;
      max-width: 420px;
      background: #FFFFFF;
      border-radius: 24px;
      padding: 40px 24px;
      text-align: center;
      box-shadow: 0 16px 40px -10px rgba(2, 48, 45, 0.08), 0 0 0 1px rgba(2, 48, 45, 0.05);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .logo-box {
      margin-bottom: 24px;
    }
    .spinner-ring {
      width: 38px;
      height: 38px;
      border: 3px solid #E2E8F0;
      border-top-color: #3C7730;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-bottom: 20px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    .redirect-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: #02302D;
      margin-bottom: 6px;
    }
    .redirect-sub {
      font-size: 0.82rem;
      color: #64748B;
      margin: 0;
    }
  </style>

  <script>
    const path = window.location.pathname;
    if (path.includes('/feedback/')) {
      const parts = path.split('/feedback/');
      const code = parts[1]?.replace(/\/$/, '');
      if (code) {
        window.location.href = `/feedback/${code}`;
      } else {
        window.location.href = '/feedback/QR-ORANGE-TUNIS-01';
      }
    } else {
      window.location.href = '/feedback/QR-ORANGE-TUNIS-01';
    }
  </script>
</FeedbackLayout>
