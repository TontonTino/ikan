---
export interface Props {
  width?: number;
  height?: number;
  alt?: string;
  class?: string;
  size?: number;
  /** dark : logo principal (texte noir), fond clair. white : logo principal blanc, fond foncé. Variantes officielles seulement. */
  variant?: 'dark' | 'white';
}

const {
  width,
  height,
  size = 140,
  alt = 'IKAN AI',
  class: className = '',
  variant = 'dark',
} = Astro.props;

const targetWidth = width || size || 140;
const logoSrc = variant === 'white' ? '/ikanai-logo-stacked-white.png' : '/ikanai-logo-stacked.png';
---

<div class={`ikan-logo-official-container ${className}`} style={`width: ${targetWidth}px;`}>
  <img
    src={logoSrc}
    alt={alt}
    class="ikan-logo-official-img"
    loading="eager"
    decoding="sync"
  />
</div>

<style>
  .ikan-logo-official-container {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    position: relative;
  }
  .ikan-logo-official-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
</style>
