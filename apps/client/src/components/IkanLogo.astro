---
export interface Props {
  width?: number;
  height?: number;
  alt?: string;
  class?: string;
  size?: number;
  variant?: 'dark' | 'green' | 'lime' | 'white';
}

const {
  width,
  height,
  size = 140,
  alt = 'IKAN AI',
  class: className = '',
  variant = 'dark',
} = Astro.props;

const targetWidth = width || size || 140;
const logoSrc = variant === 'green'
  ? '/ikanai-logo-horizontal-green.png'
  : variant === 'lime'
    ? '/ikanai-logo-horizontal-lime.png'
    : variant === 'white'
      ? '/ikanai-mark-white.png'
      : '/ikanai-logo-stacked.png';
---

<div class={`ikan-logo-official-container ${className}`} style={`width: ${targetWidth}px;`}>
  <img
    src={logoSrc}
    alt={alt}
    class="ikan-logo-official-img"
    loading="eager"
    decoding="sync"
  />
</div>

<style>
  .ikan-logo-official-container {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    position: relative;
  }
  .ikan-logo-official-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
</style>
