# Configuration Meta Graph API (valeurs fictives pour exemple)
VEILLE_FB_APP_ID=123456789012345
VEILLE_FB_APP_SECRET=REPLACE_WITH_META_APP_SECRET
VEILLE_FB_API_VERSION=v21.0
VEILLE_FB_PAGE_ACCESS_TOKEN=REPLACE_WITH_PAGE_ACCESS_TOKEN
VEILLE_FB_DEFAULT_PAGE_ID=987654321098765
# Rechargement au démarrage (disque éphémère) : si ces 3 variables sont définies
# (VEILLE_FB_PAGE_ACCESS_TOKEN, VEILLE_FB_DEFAULT_PAGE_ID, VEILLE_BOOTSTRAP_CLIENT_ID),
# la Page par défaut est réenregistrée pour ce client (UUID de l'organisation IKAN AI).
VEILLE_BOOTSTRAP_CLIENT_ID=
VEILLE_FB_REDIRECT_URI=http://127.0.0.1:8001/connect/facebook/callback
VEILLE_FB_LOGIN_CONFIG_ID=

# Environnement : dev ou production
VEILLE_ENV=dev

# Clé API requise hors de l'environnement dev (header X-API-Key)
VEILLE_API_KEY=REPLACE_WITH_API_KEY

# Sécurité des jetons et de l'état OAuth (obligatoires en production)
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VEILLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# Secret HMAC pour signer le state OAuth anti-CSRF
VEILLE_STATE_SECRET=REPLACE_WITH_STATE_SECRET

# Origines autorisées pour les redirections OAuth et CORS
VEILLE_ALLOWED_RETURN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VEILLE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VEILLE_LOG_LEVEL=INFO

# Synchronisation et cycle de vie des jetons
VEILLE_SYNC_INTERVAL_MINUTES=60
VEILLE_LOOKBACK_DAYS=30
VEILLE_TOKEN_WARN_DAYS=7
VEILLE_DATA_ACCESS_WARN_DAYS=14
VEILLE_TOKEN_CHECK_INTERVAL_HOURS=6
VEILLE_ALERT_WEBHOOK_URL=
