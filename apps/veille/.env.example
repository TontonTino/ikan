# Copier en .env (jamais commité)
VEILLE_HEADLESS=true
VEILLE_LOCALE=fr-FR
VEILLE_TIMEZONE=Africa/Ouagadougou
VEILLE_NAV_TIMEOUT_MS=30000
VEILLE_ACTION_TIMEOUT_MS=5000
VEILLE_STATE_DIR=state
VEILLE_DEBUG_DIR=debug
VEILLE_LOG_LEVEL=INFO
VEILLE_HOST=0.0.0.0
VEILLE_PORT=8002

# Protection anti-détection et diagnostics
VEILLE_STEALTH_ENABLED=true
VEILLE_SAVE_DEBUG_ARTIFACTS=true

# Clé exigée par l'API (header X-API-Key). Générer avec :
# python -c "import secrets; print(secrets.token_urlsafe(32))"
VEILLE_API_KEY=
VEILLE_MAX_CONCURRENT_SCRAPES=2

# Configuration proxy optionnelle (format: http://host:port)
# VEILLE_PROXY_SERVER=http://proxy.example.com:8080
# VEILLE_PROXY_USERNAME=
# VEILLE_PROXY_PASSWORD=
