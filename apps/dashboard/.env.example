# Adresses des services utilisés par le dashboard (sans slash final).
# Vite n'expose au code du navigateur que les variables préfixées VITE_.
#
# En DÉVELOPPEMENT, chaque variable est facultative : repli sur localhost
#   (API via le proxy de Vite → http://localhost:8000, formulaire client → http://localhost:4321, YAM → http://localhost:8001).
# En PRODUCTION, les trois premières sont OBLIGATOIRES : `npm run build` s'arrête et `npm start` refuse de démarrer
#   en nommant la variable manquante (voir variables-requises.mjs). Renseignez-les dans l'environnement du service.

# API principale (FastAPI)
VITE_API_URL=http://localhost:8000/api/v1

# Formulaire client public (Astro), cible des QR codes imprimés
VITE_CLIENT_URL=http://localhost:4321

# Agent IA YAM (panneau de discussion)
VITE_AGENT_URL=http://localhost:8001

# Présence de YAM dans le dashboard (facultatif) : « non » retire la mascotte et ses interventions.
# VITE_YAM_PRESENCE=non
