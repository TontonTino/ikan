# URL de base de l'API Backend (sans slash final)
# Vite n'expose au code client que les variables préfixées VITE_.
# Pour le développement local avec le backend FastAPI :
VITE_API_URL=http://localhost:8000/api/v1

# Pour pointer vers la production Render :
# VITE_API_URL=https://ikan-772d.onrender.com/api/v1

# URL de base de l'application client (formulaire de feedback public, scanné via QR code)
VITE_CLIENT_URL=https://ikan-1.onrender.com

# URL de base de l'agent IA YAM (assistant du panneau de chat, sans slash final).
# En local : http://localhost:8001 ; en production : https://yam-tpip.onrender.com
VITE_AGENT_URL=https://yam-tpip.onrender.com
