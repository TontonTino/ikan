# URL de base de l'API Backend (sans slash final)
# Vite n'expose au code client que les variables préfixées VITE_.
# Pour le développement local avec le backend FastAPI :
VITE_API_URL=http://localhost:8000/api/v1

# Pour pointer vers la production Render :
